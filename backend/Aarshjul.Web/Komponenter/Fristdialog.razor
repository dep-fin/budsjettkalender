@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject IAuthorizationService Autorisering

@{ _vistForslagsfeil = _forslagsfeil; }
<dialog @ref="_dialog" class="fristdialog" aria-labelledby="fristdialog-tittel" data-visning="@_visning"
        data-tilbake="@((_forslag || (!_sendt && _frist is not null && _agendadato is not null)) ? "true" : "false")"
        data-sender="@(_sender ? "true" : "false")">
    <div class="dialogtopp">
        @if (!_forslag && !_sendt && _frist is not null && _agendadato is not null)
        {
            <button class="knapp" @onclick="TilbakeAsync">‹ Tilbake til dagsagenda</button>
        }
        <button class="knapp dialoglukk" disabled="@_sender" @onclick="LukkAsync">Lukk</button>
    </div>
    @if (_forslag)
    {
        <div class="dialoginnhold">
            <p class="menyoverskrift">Til behandling</p>
            <h2 id="fristdialog-tittel" tabindex="-1">@(_frist is null ? "Foreslå en frist" : "Foreslå endring på en publisert frist")</h2>
            <Forslagsskjema @key="_registrering" FristId="_frist?.Id" Startdato="_agendadato" Startbudsjettaar="Startbudsjettaar"
                           Sendt="ForslagSendtAsync" Avbrutt="AvbrytForslagAsync" InnsendingPaagaar="VedInnsendingAsync" />
        </div>
    }
    else if (_sendt)
    {
        <div class="dialoginnhold forslagskvittering" role="status">
            <p class="menyoverskrift">Venter på behandling</p>
            <h2 id="fristdialog-tittel" tabindex="-1">Forslaget er sendt inn</h2>
            <p>Administrator behandler forslaget før fristen blir publisert. Du kan følge behandlingen under Mine forslag.</p>
            <div class="dialoghandlinger">
                <a class="knapp knapp-primær" href="/forslag/mine">Mine forslag</a>
                <button class="knapp" @onclick="TilbakeEtterForslagAsync">@(_agendadato is not null ? "Tilbake til dagsagenda" : "Tilbake til fristen")</button>
            </div>
        </div>
    }
    else if (_frist is { } frist)
    {
        <div class="dialoginnhold @Visningformat.FargeklasseForAar(frist.Budsjettaar)">
            <p class="menyoverskrift">Fristdetaljer</p>
            <h2 id="fristdialog-tittel" tabindex="-1">@frist.Tittel</h2>
            <dl class="fristdetaljer">
                <div><dt>Dato og tid</dt><dd>@Visningformat.FormatDato(frist)@if (!frist.ErTentativ && !frist.HarKlokkeslett) { <span> · Heldag</span> }</dd></div>
                <div><dt>Kategori</dt><dd>@Visningformat.KategoriNavn(frist.Kategori)</dd></div>
                <div><dt>Budsjettår</dt><dd><span class="aarsprikk" aria-hidden="true"></span>@frist.Budsjettaar</dd></div>
            </dl>
            @if (frist.ErTentativ)
            {
                <p><span class="merke merke-tentativ">Tentativ måned – dato ikke fastsatt</span></p>
            }
            <AuthorizeView Policy="@Autorisasjon.ErAdministrator">
                @if (frist.VenterEndring)
                {
                    <p><span class="merke merke-venter-endring">venter endring</span></p>
                }
                @if (frist.Synlighet.Count > 0)
                {
                    <p class="fristkort-grupper">Synlig for:
                        @foreach (var gruppe in frist.Synlighet) { <span class="merke merke-gruppe">@gruppe</span> }
                    </p>
                }
            </AuthorizeView>
            @if (frist.KildeUrl is { } kildeUrl)
            {
                <section class="dialogkilde" aria-label="Kilderundskriv">
                    <h3>Kilderundskriv</h3>
                    <a href="@kildeUrl" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">Les rundskrivet på regjeringen.no <span>(åpnes i ny fane)</span></a>
                </section>
            }
            <section class="dialognotat" aria-label="Om fristen">
                <h3>Om fristen</h3>
                <p>@(string.IsNullOrWhiteSpace(frist.Notat) ? "Ingen merknader til fristen." : frist.Notat)</p>
            </section>
            <AuthorizeView Policy="@Autorisasjon.ErAdministrator">
                <div class="dialoghandlinger"><a class="knapp" href="@($"/admin/frist/{frist.Id}")">Rediger</a></div>
            </AuthorizeView>
            @if (VisIKalenderen.HasDelegate)
            {
                <div class="dialoghandlinger"><button class="knapp" @onclick="() => TilKalenderAsync(frist)">Vis i kalenderen</button></div>
            }
            <AuthorizeView Policy="@Autorisasjon.ErBidragsyter">
                <div class="dialoghandlinger"><button class="knapp" data-dialoghandling="endre" @onclick="AapneForslagAsync">Foreslå endring</button></div>
            </AuthorizeView>
        </div>
    }
    else if (_agendadato is { } dato)
    {
        <div class="dialoginnhold">
            <p class="menyoverskrift">Dagsagenda</p>
            <h2 id="fristdialog-tittel" tabindex="-1">Frister @Kalendervisning.Dato(dato)</h2>
            @if (_dagsfrister.Count == 0)
            {
                <p class="melding">Ingen frister denne dagen.</p>
            }
            else
            {
                <p class="dempet">@_dagsfrister.Count @(_dagsfrister.Count == 1 ? "frist" : "frister") denne dagen</p>
                <div class="agenda-frister">
                    @foreach (var dagsfrist in _dagsfrister)
                    {
                        <button class="agenda-frist @Visningformat.FargeklasseForAar(dagsfrist.Budsjettaar)" data-frist-id="@dagsfrist.Id"
                                aria-label="@dagsfrist.Tittel" @onclick="() => VisFraAgendaAsync(dagsfrist)">
                            <span>@(dagsfrist.Klokkeslett is { } tid ? $"Kl. {tid:HH:mm}" : "Heldag")</span>
                            <strong>@dagsfrist.Tittel</strong>
                            <span>@Visningformat.KategoriNavn(dagsfrist.Kategori) · Budsjettår @dagsfrist.Budsjettaar</span>
                        </button>
                    }
                </div>
            }
            <AuthorizeView Policy="@Autorisasjon.ErBidragsyter">
                <div class="dialoghandlinger">
                    <p class="dempet">Har du en frist som mangler? Send et forslag til administrator.</p>
                    <button class="knapp knapp-primær" data-dialoghandling="foreslaa" @onclick="AapneForslagAsync">Foreslå frist</button>
                </div>
            </AuthorizeView>
        </div>
    }
    @if (_forslagsfeil is not null)
    {
        <div class="feil dialogfeil" role="alert" tabindex="-1" @ref="_feilfelt">@_forslagsfeil</div>
    }
</dialog>

@code {
    [Parameter] public EventCallback<FristDto> VisIKalenderen { get; set; }
    [Parameter] public int? Startbudsjettaar { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _modul;
    private DotNetObjectReference<Fristdialog>? _referanse;
    private DateOnly? _agendadato;
    private IReadOnlyList<FristDto> _dagsfrister = [];
    private FristDto? _frist;
    private bool _vis;
    private long _visning;
    private bool _avsluttet;
    private string? _fokusFrist;
    private string? _fokusHandling;
    private string? _forslagsfeil;
    private string? _vistForslagsfeil;
    private ElementReference _feilfelt;
    private bool _fokuserFeil;
    private bool _forslag;
    private bool _sendt;
    private bool _sender;
    private int _registrering;

    public Task VisAgendaAsync(DateOnly dato, IReadOnlyList<FristDto> frister)
    {
        _agendadato = dato;
        _dagsfrister = frister;
        _frist = null;
        BeOmVisning();
        _fokusFrist = null;
        NullstillForslag();
        return InvokeAsync(StateHasChanged);
    }

    public Task VisFristAsync(FristDto frist)
    {
        _agendadato = null;
        _frist = frist;
        BeOmVisning();
        _fokusFrist = null;
        NullstillForslag();
        return InvokeAsync(StateHasChanged);
    }

    private Task VisFraAgendaAsync(FristDto frist)
    {
        _frist = frist;
        BeOmVisning();
        _fokusFrist = null;
        return Task.CompletedTask;
    }

    private Task TilbakeAsync()
    {
        _fokusFrist = _frist?.Id.ToString();
        _frist = null;
        BeOmVisning();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task TilbakeFraTastaturAsync()
    {
        if (_sender) return Task.CompletedTask;
        if (_forslag)
        {
            AvbrytForslagAsync();
            return InvokeAsync(StateHasChanged);
        }
        if (_frist is null || _agendadato is null) return Task.CompletedTask;
        TilbakeAsync();
        return InvokeAsync(StateHasChanged);
    }

    private async Task LukkAsync()
    {
        if (_sender) return;
        if (_modul is not null) await _modul.InvokeVoidAsync("lukk", _dialog);
    }

    private void NullstillForslag()
    {
        _forslag = false;
        _sendt = false;
        _sender = false;
        _forslagsfeil = null;
        _fokusHandling = null;
    }

    private void BeOmVisning()
    {
        _vis = true;
        _visning++;
    }

    private async Task AapneForslagAsync()
    {
        if (_forslag || _sender) return;
        // AuthorizeView skjuler handlingen, men håndhever ikke serverhendelsen.
        if (!(await Autorisering.AuthorizeAsync((await AuthState.GetAuthenticationStateAsync()).User, Autorisasjon.ErBidragsyter)).Succeeded)
        {
            _forslagsfeil = "Du har ikke tilgang til å sende forslag.";
            _fokuserFeil = true;
            return;
        }
        _registrering++;
        _forslag = true;
        _sendt = false;
        _forslagsfeil = null;
        _fokusHandling = null;
        BeOmVisning();
    }

    private Task AvbrytForslagAsync()
    {
        if (_sender) return Task.CompletedTask;
        _forslag = false;
        _fokusHandling = _frist is null ? "foreslaa" : "endre";
        BeOmVisning();
        return Task.CompletedTask;
    }

    private Task ForslagSendtAsync()
    {
        _forslag = false;
        _sendt = true;
        _fokusHandling = null;
        BeOmVisning();
        return Task.CompletedTask;
    }

    private Task TilbakeEtterForslagAsync()
    {
        _sendt = false;
        if (_agendadato is not null) _frist = null;
        _fokusHandling = _frist is null ? "foreslaa" : "endre";
        BeOmVisning();
        return Task.CompletedTask;
    }

    private async Task VedInnsendingAsync(bool paagaar)
    {
        _sender = paagaar;
        if (_modul is not null && !_avsluttet) await _modul.InvokeVoidAsync("innsending", _dialog, paagaar);
    }

    private async Task TilKalenderAsync(FristDto frist)
    {
        await LukkAsync();
        if (!_avsluttet) await VisIKalenderen.InvokeAsync(frist);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_fokuserFeil && _vistForslagsfeil == _forslagsfeil && _feilfelt.Context is not null && !_avsluttet)
        {
            _fokuserFeil = false;
            await _feilfelt.FocusAsync();
        }
        if (!_vis || _avsluttet) return;
        _vis = false;
        var visning = _visning;
        var fokusFrist = _fokusFrist;
        var fokusHandling = _fokusHandling;
        if (_modul is null)
        {
            var modul = await JS.InvokeAsync<IJSObjectReference>("import", "./kalenderdialog.js");
            // Navigasjon eller en annen render kan ha fullført mens importen ventet.
            if (_avsluttet || _modul is not null)
            {
                try { await modul.DisposeAsync(); }
                catch (JSDisconnectedException) { }
            }
            else _modul = modul;
        }
        if (_avsluttet) return;
        _referanse ??= DotNetObjectReference.Create(this);
        await _modul!.InvokeVoidAsync("vis", _dialog, fokusFrist, visning, _referanse, fokusHandling);
    }

    public async ValueTask DisposeAsync()
    {
        _avsluttet = true;
        _referanse?.Dispose();
        if (_modul is null) return;
        try { await _modul.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
