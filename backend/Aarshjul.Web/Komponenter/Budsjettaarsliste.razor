<ol class="kalenderliste budsjettaarsliste">
    @foreach (var frist in Frister.OrderBy(f => f.Sorteringsdag).ThenBy(f => f.Klokkeslett).ThenBy(f => f.Tittel).ThenBy(f => f.Id))
    {
        <li>
            <button class="listefrist @Visningformat.FargeklasseForAar(frist.Budsjettaar)" data-frist-id="@frist.Id" aria-label="@frist.Tittel" @onclick="() => AapneFrist.InvokeAsync(frist)">
                <span class="listefrist-dato">@Visningformat.FormatDato(frist)@if (frist.ErTentativ) { <small>Dato ikke fastsatt</small> } else if (!frist.HarKlokkeslett) { <small>Heldag</small> }</span>
                <span><strong class="hjul-tittel">@frist.Tittel</strong><small>@Visningformat.KategoriNavn(frist.Kategori)</small></span>
                <span class="listefrist-aar"><i class="aarsprikk" aria-hidden="true"></i>Budsjettår @frist.Budsjettaar</span>
            </button>
        </li>
    }
</ol>

@code {
    [Parameter] public IReadOnlyList<FristDto> Frister { get; set; } = [];
    [Parameter] public EventCallback<FristDto> AapneFrist { get; set; }
}
