@page "/admin/grupper"
@attribute [Authorize(Policy = Autorisasjon.ErAdministrator)]

<PageTitle>Grupper</PageTitle>
<NavigationLock OnBeforeInternalNavigation="FoerNavigasjon" />
<p class="menyoverskrift">Grupper og innsyn</p>
<div class="gruppetopp">
    <div><h1>Grupper</h1><p class="ingress">Vedlikehold hvem fristene kan deles med. Kontroller det publiserte innholdet under Innsyn.</p></div>
    <button type="button" class="knapp knapp-primær" @onclick="NyGruppe" disabled="@(_laster || _arbeider)">Ny gruppe</button>
</div>
@if (_melding is not null) { <p class="gruppestatus" role="status">@_melding</p> }
@if (_lastfeil is not null)
{
    <div class="feil" role="alert"><p>@_lastfeil</p><button class="knapp" disabled="@_laster" @onclick="LastAsync">Prøv igjen</button></div>
}
@if (_laster) { <p class="melding" role="status">Laster grupper …</p> }
else if (_lastfeil is null)
{
    <section class="gruppeoversikt" aria-labelledby="alle-grupper">
        <div class="gruppeliste-topp"><h2 id="alle-grupper">Synlighetsgrupper</h2><span>@_grupper.Count grupper</span></div>
        <table class="tabell gruppetabell">
            <thead><tr><th scope="col">Kode</th><th scope="col">Visningsnavn</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Handling</th></tr></thead>
            <tbody>
                @foreach (var gruppe in _grupper)
                {
                    <tr @key="gruppe.Kode">
                        <td data-label="Kode"><strong class="gruppekode">@gruppe.Kode</strong></td>
                        <td data-label="Visningsnavn"><span>@gruppe.Navn</span></td>
                        <td data-label="Type"><span>@(gruppe.ErStandard ? "Innebygd" : "Egendefinert")</span></td>
                        <td data-label="Status"><span class="gruppemerke @(gruppe.Aktiv ? "aktiv" : "inaktiv")">@(gruppe.Aktiv ? "Aktiv" : "Inaktiv")</span></td>
                        <td data-label="Handling"><button type="button" class="knapp" @onclick="() => Rediger(gruppe)" disabled="@_arbeider">Rediger</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_grupper.Count == 0) { <p class="melding">Ingen synlighetsgrupper er opprettet.</p> }
    </section>
    <p class="gruppeforklaring">Gruppekoden er fast etter oppretting. Inaktive grupper tilbys ikke i nye valg; eksisterende frister og medlemskap beholder referansene sine.</p>
}
<dialog @ref="_dialog" class="gruppedialog" aria-labelledby="gruppedialog-tittel" data-visning="@_visning" data-redigerer="@(_redigerer ? "true" : "false")" data-arbeider="@(_arbeider ? "true" : "false")">
    @if (_redigerer)
    {
        <form class="skjema gruppeskjema" aria-label="@(_oppretter ? "Ny synlighetsgruppe" : "Rediger synlighetsgruppe")" @onsubmit="LagreAsync" @onsubmit:preventDefault="true" novalidate>
            <div><p class="menyoverskrift">Synlighetsgruppe</p><h2 id="gruppedialog-tittel" tabindex="-1">@(_oppretter ? "Ny gruppe" : "Rediger gruppe")</h2></div>
            @if (_feil is not null)
            {
                <div class="feil" role="alert" tabindex="-1" @ref="_feilfelt"><strong>@_feil</strong>
                    @if (_feltfeil.Count > 0) { <ul>@foreach (var feil in _feltfeil) { <li><a href="@($"#gruppe-{feil.Key}")">@feil.Value</a></li> }</ul> }
                </div>
            }
            @if (_oppretter)
            {
                <div><label for="gruppe-kode">Kode</label><input id="gruppe-kode" @bind="_kode" @bind:event="oninput" maxlength="64" aria-describedby="@Beskrivelse("kode", "gruppe-kodehjelp")" aria-invalid="@Ugyldig("kode")" disabled="@_arbeider" />
                    <small id="gruppe-kodehjelp" class="hint">1–64 tegn: A–Z, 0–9 og bindestrek. Begynn med en bokstav. Lagres med store bokstaver.</small>
                    @if (_feltfeil.TryGetValue("kode", out var kodefeil)) { <small id="gruppe-kodefeil" class="gruppefeltfeil">@kodefeil</small> }
                </div>
            }
            else { <div class="fastgruppekode"><span>Kode</span><strong>@_kode</strong><small>Kan ikke endres.</small></div> }
            <div><label for="gruppe-navn">Visningsnavn</label><input id="gruppe-navn" @bind="_navn" @bind:event="oninput" maxlength="256" aria-describedby="@Beskrivelse("navn", "gruppe-navnhjelp")" aria-invalid="@Ugyldig("navn")" disabled="@_arbeider" />
                <small id="gruppe-navnhjelp" class="hint">1–256 tegn. Bruk et navn som er lett å kjenne igjen.</small>
                @if (_feltfeil.TryGetValue("navn", out var navnfeil)) { <small id="gruppe-navnfeil" class="gruppefeltfeil">@navnfeil</small> }
            </div>
            @if (!_oppretter)
            {
                <div><label class="filtervalg" for="gruppe-aktiv"><input id="gruppe-aktiv" type="checkbox" @bind="_aktiv" disabled="@_arbeider" aria-describedby="gruppe-aktivhjelp" />Aktiv</label><p id="gruppe-aktivhjelp" class="hint">En inaktiv gruppe kan ikke velges ved ny deling. Eksisterende referanser beholdes.</p></div>
            }
            <div class="gruppehandlinger"><button type="submit" class="knapp knapp-primær" disabled="@_arbeider">@(_arbeider ? "Lagrer …" : _oppretter ? "Opprett gruppe" : "Lagre endringer")</button><button type="button" class="knapp" @onclick="AvbrytAsync" disabled="@_arbeider">Avbryt</button></div>
        </form>
    }
</dialog>
