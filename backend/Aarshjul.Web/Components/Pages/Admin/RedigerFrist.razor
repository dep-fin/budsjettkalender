@page "/admin/frist/ny"
@page "/admin/frist/{Id:guid}"
@page "/admin/frist/juster/{ForslagId:guid}"
@attribute [Authorize(Policy = Autorisasjon.ErAdministrator)]
@implements IDisposable
@inject IFristskriving Skriving
@inject IGodkjenningsko Ko
@inject IGruppetjeneste Grupper
@inject NavigationManager Nav
@inject TimeProvider Klokke
@inject ILogger<RedigerFrist> Logg

<NavigationLock OnBeforeInternalNavigation="FoerNavigasjon" ConfirmExternalNavigation="@_lagrer" />

<PageTitle>@Tittel</PageTitle>

<h1>@Tittel</h1>
<p class="melding">Arbeidsår: @(_arbeidsaar?.ToString() ?? "Alle år"). Budsjettår og kalenderdato kan være forskjellige.</p>

@if (ErJuster)
{
    <p class="melding">
        Du justerer et innkommet forslag. «Lagre» publiserer fristen med de justerte verdiene.
        @if (_erEndre)
        {
            <text>Dette er et endringsforslag — det oppdaterer kun innholdet på den berørte fristen, og synligheten står uendret.</text>
        }
    </p>
}

@if (!_lastet)
{
    <p class="melding">Laster …</p>
}
else if (_lastfeil is not null)
{
    <p class="feil" role="alert">@_lastfeil</p>
    <button type="button" class="knapp" @onclick="LastAsync">Prøv igjen</button>
}
else if (_inndata is null)
{
    <p class="melding">@(ErJuster ? "Forslaget finnes ikke eller er allerede behandlet." : "Fristen finnes ikke.")</p>
}
else
{
    @if (_uttrekksbevis is { Bevis.Count: > 0 } bevis)
    {
        <section class="justeringsbevis" aria-label="Opprinnelig uttrekksbevis">
            <h2>Kontroller kildegrunnlaget</h2>
            <p>@bevis.KildeEllerInnsender. Bevisene viser de opprinnelige tolkingene, også når du endrer feltene nedenfor.</p>
            <Uttrekksbevis Bevis="bevis.Bevis" />
        </section>
    }
    @if (_feil is not null)
    {
        <div class="feil" role="alert" tabindex="-1" @ref="_feilfelt">@_feil</div>
    }

    <form class="skjema" @onsubmit="Lagre" @onsubmit:preventDefault="true">
        <fieldset class="fristfelter" disabled="@_lagrer">
        <label>Tittel
            <input @bind="_inndata.Tittel" />
        </label>

        <div class="skjemarad">
            <label>Presisjon
                <select @bind="_inndata.Datopresisjon">
                    <option value="@Datopresisjon.Dag">Dag</option>
                    <option value="@Datopresisjon.Maaned">Måned</option>
                </select>
            </label>

            <label>Dato
                <input type="date" @bind="_inndata.Dato" />
            </label>

            @if (_inndata.Datopresisjon == Datopresisjon.Maaned)
            {
                <label>Kvalifikator
                    <select @bind="_kvalifikatorValg">
                        <option value="">(ingen)</option>
                        <option value="Primo">Primo</option>
                        <option value="Medio">Medio</option>
                        <option value="Ultimo">Ultimo</option>
                    </select>
                </label>
            }
            else
            {
                <label>Klokkeslett (valgfritt – tomt = heldags)
                    <input type="time" @bind="_inndata.Klokkeslett" />
                </label>
            }
        </div>

        <div class="skjemarad">
            <label>Budsjettår
                <input type="number" @bind="_inndata.Budsjettaar" />
            </label>

            <label>Kategori
                <select @bind="_inndata.Kategori">
                    <option value="@Kategori.Budsjett">Budsjett</option>
                    <option value="@Kategori.Gulbok">Gul bok</option>
                    <option value="@Kategori.Regnskap">Regnskap</option>
                </select>
            </label>

            <label>Løp
                <input @bind="_inndata.Loep" placeholder="f.eks. rammefordeling" />
            </label>
        </div>

        <label>Notat
            <textarea @bind="_inndata.Notat" rows="2"></textarea>
        </label>

        @if (!_erEndre)
        {
            <fieldset class="synlighet">
                <legend>Synlig for (velg minst én – POL settes kun ved aktivt valg)</legend>
                @foreach (var gruppe in _grupper)
                {
                    <label class="filtervalg @(gruppe.Kode == "POL" ? "pol-valg" : "")">
                        <input type="checkbox"
                               @bind:get="_inndata.Synlighetskoder.Contains(gruppe.Kode)"
                               @bind:set="på => VekslGruppe(gruppe.Kode, på)" />
                        @gruppe.Navn (@gruppe.Kode)
                    </label>
                }
                @if (_inaktive.Count > 0)
                {
                    <p>Eksisterende tilordninger til inaktive grupper kan beholdes eller fjernes.</p>
                    @foreach (var gruppe in _inaktive)
                    {
                        <label class="filtervalg @(gruppe.Kode == "POL" ? "pol-valg" : "")">
                            <input type="checkbox"
                                   @bind:get="_inndata.Synlighetskoder.Contains(gruppe.Kode)"
                                   @bind:set="på => VekslGruppe(gruppe.Kode, på)" />
                            @gruppe.Navn (@gruppe.Kode) – inaktiv, eksisterende tilordning
                        </label>
                    }
                }
            </fieldset>
        }

        <div class="skjemarad">
            <button type="submit" class="knapp knapp-primær" disabled="@(_lagrer || _lagret)">@(_lagrer ? "Lagrer …" : "Lagre")</button>
            <button type="button" class="knapp" disabled="@_lagrer" @onclick="() => Nav.NavigateTo(Retur)">Avbryt</button>
        </div>
        </fieldset>
    </form>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public Guid? ForslagId { get; set; }
    [SupplyParameterFromQuery(Name = "aar")] public string? AarQuery { get; set; }
    [SupplyParameterFromQuery(Name = "fra")] public string? Fra { get; set; }

    private FristInndata? _inndata;
    private Koelement? _uttrekksbevis;
    private IReadOnlyList<GruppeDto> _grupper = [];
    private IReadOnlyList<GruppeadministrasjonDto> _inaktive = [];
    private string _kvalifikatorValg = "";
    private string? _feil;
    private string? _lastfeil;
    private bool _lastet;
    private bool _erEndre;
    private bool _lagrer;
    private bool _lagret;
    private bool _fokuserFeil;
    private ElementReference _feilfelt;
    private int? _arbeidsaar;
    private readonly CancellationTokenSource _levetid = new();
    private bool _avsluttet;
    private int _lastVersjon, _inndataVersjon;
    private Guid? _inndataId, _inndataForslagId;
    private string? _lastenoekkel;
    private string Retur => Arbeidsaarkontekst.Lenke(ErJuster
        ? Fra == "generering" ? "/admin/generer" : "/admin/ko" : "/admin/frister", _arbeidsaar);

    private bool ErJuster => ForslagId is not null;

    private string Tittel => ForslagId is not null
        ? "Juster forslag"
        : Id is null ? "Ny frist" : "Rediger frist";

    protected override Task OnParametersSetAsync()
    {
        var noekkel = $"{Id}/{ForslagId}/{AarQuery}/{Fra}";
        if (_lastenoekkel == noekkel) return Task.CompletedTask;
        _lastenoekkel = noekkel;
        return LastAsync();
    }

    private async Task LastAsync()
    {
        if (_avsluttet) return;
        var versjon = ++_lastVersjon;
        var maalId = Id;
        var forslagId = ForslagId;
        _arbeidsaar = Arbeidsaarkontekst.Les(AarQuery, Klokke);
        var arbeidsaar = _arbeidsaar;
        _lastet = false;
        _inndata = null;
        _inndataId = null;
        _inndataForslagId = null;
        _kvalifikatorValg = "";
        _feil = null;
        _lastfeil = null;
        _fokuserFeil = false;
        _lagret = false;
        _erEndre = false;
        _inaktive = [];
        _uttrekksbevis = null;
        try
        {
            var grupper = await Grupper.HentAktiveAsync(_levetid.Token);
            if (!ErGjeldende(versjon)) return;
            FristInndata? inndata;
            Koelement? bevis = null;
            IReadOnlyList<GruppeadministrasjonDto> inaktive = [];
            var erEndring = false;
            if (forslagId is { } justerId)
            {
                var forberedt = await Ko.HentForslagForJusteringAsync(justerId, _levetid.Token);
                if (!ErGjeldende(versjon)) return;
                inndata = forberedt?.Felter;
                erEndring = forberedt?.ErEndring ?? false;
                if (inndata is not null)
                {
                    var ko = await Ko.HentKoAsync(new() { Budsjettaar = inndata.Budsjettaar }, _levetid.Token);
                    if (!ErGjeldende(versjon)) return;
                    bevis = ko.FirstOrDefault(f => f.Id == justerId);
                    if (!erEndring)
                        inndata.Synlighetskoder = inndata.Synlighetskoder.Where(k => grupper.Any(g => g.Kode == k)).ToList();
                }
            }
            else if (maalId is null)
            {
                inndata = new FristInndata
                {
                    Budsjettaar = arbeidsaar ?? Arbeidsaarkontekst.Standardaar(Klokke),
                    Dato = Datohjelp.Idag(Klokke)
                };
            }
            else
            {
                inndata = await Skriving.HentForRedigeringAsync(maalId.Value, _levetid.Token);
                if (!ErGjeldende(versjon)) return;
                if (inndata is not null)
                {
                    var alleGrupper = await Grupper.HentAlleAsync(_levetid.Token);
                    if (!ErGjeldende(versjon)) return;
                    inaktive = alleGrupper.Where(g => !g.Aktiv && inndata.Synlighetskoder.Contains(g.Kode)).ToList();
                }
            }
            _grupper = grupper;
            _inaktive = inaktive;
            _erEndre = erEndring;
            _uttrekksbevis = bevis;
            _inndata = inndata;
            _inndataId = maalId;
            _inndataForslagId = forslagId;
            _inndataVersjon = versjon;
            _kvalifikatorValg = inndata?.Datokvalifikator?.ToString() ?? "";
        }
        catch (OperationCanceledException) when (_levetid.IsCancellationRequested) { }
        catch (Exception e)
        {
            if (!ErGjeldende(versjon)) return;
            Logg.LogError(e, "Kunne ikke laste frist eller forslag for redigering.");
            _lastfeil = "Kunne ikke laste feltene og kildegrunnlaget akkurat nå. Prøv igjen.";
        }
        finally { if (ErGjeldende(versjon)) _lastet = true; }
    }

    private bool ErGjeldende(int versjon) => !_avsluttet && versjon == _lastVersjon;

    private void VekslGruppe(string kode, bool på)
    {
        if (på)
        {
            if (!_inndata!.Synlighetskoder.Contains(kode))
            {
                _inndata.Synlighetskoder.Add(kode);
            }
        }
        else
        {
            _inndata!.Synlighetskoder.Remove(kode);
        }
    }

    private async Task Lagre()
    {
        if (!_lastet || _lagrer || _lagret || _inndata is null || !ErGjeldende(_inndataVersjon)
            || Id != _inndataId || ForslagId != _inndataForslagId) return;
        var versjon = _inndataVersjon;
        var maalId = _inndataId;
        var forslagId = _inndataForslagId;
        var inndata = _inndata;
        var retur = Retur;
        _lagrer = true;
        _feil = null;
        _inndata!.Datokvalifikator =
            _inndata.Datopresisjon == Datopresisjon.Maaned && !string.IsNullOrEmpty(_kvalifikatorValg)
                ? Enum.Parse<Datokvalifikator>(_kvalifikatorValg)
                : null;

        try
        {
            if (forslagId is { } justerId)
            {
                await Ko.JusterOgGodkjennAsync(justerId, inndata, _levetid.Token);
            }
            else if (maalId is null)
            {
                await Skriving.OpprettAsync(inndata, _levetid.Token);
            }
            else
            {
                await Skriving.OppdaterAsync(maalId.Value, inndata, _levetid.Token);
            }
            if (!ErGjeldende(versjon)) return;
            _lagret = true;
            _lagrer = false;
            Nav.NavigateTo($"{retur}&lagretAar={inndata.Budsjettaar}");
        }
        catch (OperationCanceledException) when (_levetid.IsCancellationRequested) { }
        catch (Valideringsfeil f)
        {
            if (!ErGjeldende(versjon)) return;
            _feil = f.Message;
            _fokuserFeil = true;
        }
        finally { if (ErGjeldende(versjon)) _lagrer = false; }
    }

    private Task FoerNavigasjon(Microsoft.AspNetCore.Components.Routing.LocationChangingContext kontekst)
    {
        if (_lagrer) kontekst.PreventNavigation();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _avsluttet = true;
        _levetid.Cancel();
        _levetid.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_fokuserFeil)
        {
            _fokuserFeil = false;
            await _feilfelt.FocusAsync();
        }
    }
}
