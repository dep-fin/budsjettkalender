@page "/admin/abonnement"
@attribute [Authorize(Policy = Autorisasjon.ErAdministrator)]

<PageTitle>Del kalender (abonnement)</PageTitle>
<NavigationLock OnBeforeInternalNavigation="FoerNavigasjon" />
<p class="menyoverskrift">Eksport og deling</p>
<h1>Del kalender (abonnement)</h1>
<p class="ingress">Opprett og forvalt hemmelige lenker til en kalender som hentes på nytt.</p>
<div class="delingsinnledning">
    <section class="delingskort" aria-labelledby="levende-kalender">
        <span class="delingssymbol" aria-hidden="true">↻</span>
        <h2 id="levende-kalender">Løpende abonnement</h2>
        <p>Feeden viser godkjente frister fra og med i dag, uten historikk eller øvre datogrense. Kalenderklienten bestemmer når den henter endringer.</p>
        <p class="hint">En Word- eller ICS-fil er et øyeblikksbilde. Perioden du velger for en fil gjelder ikke abonnementet.</p>
        <a href="/admin/eksport">Last ned en fil i stedet</a>
    </section>
    <aside class="delingsvern" aria-labelledby="hemmelig-lenke">
        <h2 id="hemmelig-lenke">Lenken gir tilgang uten innlogging</h2>
        <p>Behandle lenken som en hemmelighet. Alle som har den kan hente fristene for lenkens publikum.</p>
        <p>Hvis den kommer på avveie: skru av eller slett lenken og opprett en ny. Nedlastede, importerte eller mellomlagrede data kan ikke trekkes tilbake.</p>
    </aside>
</div>
@if (_laster) { <p class="delingsstatus" role="status">Laster abonnementer …</p> }
@if (_feil is not null)
{
    <div id="abonnement-feil" class="feil" role="alert" tabindex="-1">
        <strong>Handlingen kunne ikke fullføres</strong><p>@_feil</p>
        <button class="knapp" @onclick="LastAsync" disabled="@(_laster || _arbeider)">Last på nytt</button>
    </div>
}
@if (_status is not null) { <p id="abonnement-status" class="delingsstatus" role="status" tabindex="-1">@_status</p> }
<section class="delingsskjema" aria-labelledby="ny-lenke" aria-busy="@(_arbeider ? "true" : "false")">
    <div><p class="menyoverskrift">Velg publikum</p><h2 id="ny-lenke">Ny abonnementslenke</h2><p>Velg en aktiv gruppe eller Alt. Kontroller tilgangen før lenken opprettes.</p></div>
    <div class="delingsvalg">
        <label for="abonnement-gruppe">Gruppe</label>
        <select id="abonnement-gruppe" @bind="_valgtKode" disabled="@Laast" aria-describedby="abonnement-utvalg">
            <option value="">Velg publikum</option>
            <option value="@AltPublikum">Alt (fullt innsyn – FIN-internt)</option>
            @foreach (var gruppe in _grupper) { <option value="@gruppe.Kode">@gruppe.Navn (@gruppe.Kode)</option> }
        </select>
        <small id="abonnement-utvalg">@(_valgtKode == "" ? "Ingen publikum er valgt. POL krever et aktivt valg." : $"Valgt publikum: {ValgtPublikum}.")</small>
        <button class="knapp knapp-primær" @onclick="BeOmOppretting" disabled="@(Laast || _valgtKode == "")">Opprett lenke</button>
    </div>
</section>
<section class="abonnementoversikt" aria-labelledby="eksisterende-lenker" aria-busy="@(_laster || _arbeider ? "true" : "false")">
    <div class="oversikttopp"><h2 id="eksisterende-lenker">Eksisterende lenker</h2>@if (_lastet) { <span>@_abonnementer.Count lenker</span> }</div>
    @if (_lastet && _abonnementer.Count == 0)
    {
        <div class="delingstom"><h3>Ingen lenker ennå</h3><p>Velg publikum ovenfor for å opprette den første abonnementslenken.</p></div>
    }
    else if (_abonnementer.Count > 0)
    {
        <table class="abonnementtabell">
            <thead><tr><th>Publikum</th><th>Status</th><th>Hemmelig abonnementslenke</th><th>Handlinger</th></tr></thead>
            <tbody>
                @foreach (var a in _abonnementer)
                {
                    <tr @key="a.Id">
                        <th scope="row">@Publikum(a)</th>
                        <td><span class="delingsmerke @(a.Aktiv ? "" : "avskrudd")">@(a.Aktiv ? "Aktiv" : "Avskrudd")</span></td>
                        <td class="hemmeligadresse">@if (a.Aktiv) { <code class="feed-url">@FeedUrl(a.Token)</code> } else { <span class="hint">Lenken er skjult mens den er avskrudd.</span> }</td>
                        <td><div class="radhandlinger"><button class="knapp" disabled="@Laast" @onclick="() => BeOmEndring(a, a.Aktiv ? Handling.SkruAv : Handling.SkruPaa)">@(a.Aktiv ? "Skru av" : "Skru på")</button><button class="knapp" disabled="@Laast" @onclick="() => BeOmEndring(a, Handling.Slett)">Slett</button></div></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <p class="delingsfotnote">Skru av stopper nye feedkall med 404. Skru på åpner den samme lenken igjen for eksisterende innehavere. Sletting er permanent. Klientens oppdateringsforsinkelse er ikke bekreftet her.</p>
</section>
<dialog @key="_valg" @ref="_dialog" class="abonnementdialog" aria-labelledby="abonnement-bekreft" data-valg="@_valg" data-bekreft="@(_venter is not null ? "true" : "false")" data-arbeider="@(_arbeider ? "true" : "false")">
    @if (_venter is { } vent)
    {
        <p class="menyoverskrift">Bekreft kalenderdeling</p>
        <h2 id="abonnement-bekreft">@Dialogtittel(vent.Type)</h2>
        <p>Publikum: <strong>@vent.Publikum</strong></p>
        @switch (vent.Type)
        {
            case Handling.Opprett:
                <p>Alle som får den hemmelige lenken kan hente godkjente frister for dette publikummet uten innlogging. Abonnementet følger frister fra og med i dag.</p>
                break;
            case Handling.SkruAv:
                <p>Nye feedkall vil gi 404. Kalenderklienter kan fortsatt vise data de allerede har hentet. Lenken beholdes og kan skrus på igjen.</p>
                break;
            case Handling.SkruPaa:
                <p>Den samme lenken blir aktiv igjen. Alle som allerede har lenken får tilgang på nytt. Dette oppretter ingen ny hemmelig lenke.</p>
                break;
            case Handling.Slett:
                <p>Lenken slettes permanent og vil gi 404. Den kan ikke skrus på igjen. En eventuell ny lenke må opprettes og deles på nytt.</p>
                break;
        }
        <p class="hint">Nedlastede, importerte eller mellomlagrede data kan ikke trekkes tilbake.</p>
        <div class="dialoghandlinger"><button class="knapp" autofocus disabled="@_arbeider" @onclick="AvbrytAsync">Avbryt</button><button class="knapp knapp-primær" disabled="@_arbeider" @onclick="BekreftAsync">@(_arbeider ? "Lagrer …" : Bekrefttekst(vent.Type))</button></div>
    }
</dialog>
