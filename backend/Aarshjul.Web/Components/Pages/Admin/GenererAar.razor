@page "/admin/generer"
@using Aarshjul.Application.Generering
@attribute [Authorize(Policy = Autorisasjon.ErAdministrator)]

<PageTitle>Generér budsjettår</PageTitle>
<NavigationLock OnBeforeInternalNavigation="FoerNavigasjon" />
<Arbeidsaarvelger Aar="_arbeidsaar" AarChanged="ByttAar" Deaktivert="@Opptatt" />
<div class="genereringstopp"><div><p class="menyoverskrift">Generer fra årsmal</p><h1>Generér budsjettår</h1></div><a href="/admin/mal/proev" class="knapp">Prøv malen uten lagring</a></div>
<p class="ingress">Opprett forslag fra den lagrede årsmalen, og kontroller hvert forslag før du godkjenner. Ingenting publiseres ved beregning.</p>
@if (Skriver && _navigasjonBlokkert) { <p class="melding" role="status">Vent til handlingen er fullført før du bytter side eller arbeidsår.</p> }
@if (LagretAar is { } lagret) { <p class="melding" role="status">Fristen er lagret i budsjettår @lagret. <a href="@Arbeidsaarkontekst.Lenke("/admin/frister", lagret)">Åpne fristregisteret for @lagret</a></p> }
@if (_overfoert) { <p class="genereringsstatus" role="status">Budsjettår @_maalaar og de viste midlertidige datoene er tatt med fra Prøv malen. Ingen forslag er opprettet ved overgangen.</p> }
<section class="genereringsvalg" aria-label="Beregn forslag fra årsmalen">
    <div><label for="generering-aar">Målbudsjettår</label><input id="generering-aar" type="text" inputmode="numeric" value="@_aarsfelt" @onchange="ByttMaalaar" disabled="@Opptatt" aria-invalid="@(Aarsfeil is null ? "false" : "true")" aria-describedby="generering-aar-hjelp generering-aar-feil" /><small id="generering-aar-hjelp">Ett år fra 1 til 9999. Dette blir arbeidsåret.</small></div>
    <button class="knapp knapp-primær" disabled="@(!KanGenerere)" @onclick="BeOmGenerering">@(_arbeider ? "Beregner …" : "Generér")</button>
    @if (_forslag.Count > 0 || _resultat is not null) { <button class="knapp" disabled="@(!KanGenerere)" @onclick="BeOmGenerering">Beregn på nytt med satte ankre</button> }
    @if (Aarsfeil is not null) { <p id="generering-aar-feil" class="feltfeil" role="alert">@Aarsfeil Resultatene gjelder fortsatt budsjettår @_maalaar.</p> }
    <p class="konsekvens">Årets åpne genererte forslag erstattes; godkjente frister, løpende forslag og andre år beholdes. Også en tom eller helt ugyldig mal erstatter med et tomt sett.</p>
</section>
@if (_feil is not null) { <div class="feil" role="alert"><p>@_feil</p>@if (!_lastet) { <button class="knapp" disabled="@Opptatt" @onclick="LastAsync">Prøv igjen</button> }</div> }
@if (_laster) { <p class="melding" role="status">Laster årsmal og genererte forslag …</p> }
@if (_lastet)
{
    <ManuelleAnkre Aar="_maalaar" Regler="_regler" Datoer="_ankre" Deaktivert="@(Opptatt || Aarsfeil is not null)" DatoEndret="DatoEndretAsync" FjernAlle="FjernAlleAsync" />
    <section class="beregningskontroll" aria-label="Kontroll av hele årsmalen">
        <h2>Kontroll før generering</h2><p role="status">@_rader.Count lagrede regler · @_rader.Count(r => !r.ErFeil) gyldige · @_rader.Count(r => r.ErFeil) feil for budsjettår @_maalaar. Midlertidige datoer er med; kontrollen lagrer ingenting.</p>
        @if (_previewLaster) { <p role="status">Oppdaterer beregningen …</p> }
        @if (_previewFeil is not null) { <div class="feil" role="alert"><p>@_previewFeil</p><button class="knapp" disabled="@Opptatt" @onclick="OppdaterProeveAsync">Prøv kontrollen igjen</button></div> }
        @if (_rader.Any(r => r.ErFeil)) { <div class="feil"><strong>Disse reglene gir ikke forslag:</strong><ul>@foreach (var rad in _rader.Where(r => r.ErFeil)) { <li><strong>@rad.Tittel:</strong> @(rad.Beregning.Feil ?? "Beregningen ga ingen dato.") <a href="@($"/admin/mal/{rad.Regel.Id}")">Rediger regelen</a></li> }</ul></div> }
        @if (_regler.Count == 0) { <p>Ingen regler i malen. En kjøring vil gi et tomt sett med åpne genererte forslag.</p> }
    </section>
    @if (_resultat is { } resultat)
    {
        <div class="genereringsstatus" role="status">Genererte @resultat.AntallForslag forslag for budsjettår @resultat.Maalbudsjettaar. @resultat.Feil.Count beregningsfeil. Forslagene er lagret til gjennomgang og er ikke publisert.</div>
        @if (resultat.Feil.Count > 0) { <details class="kjoeringsfeil"><summary>Feil fra siste lagrede genereringskjøring</summary><ul>@foreach (var feil in resultat.Feil) { <li>@feil</li> }</ul></details> }
    }
    @if (_status is not null) { <p class="genereringsstatus" role="status">@_status</p> }
    <div class="forslagsoverskrift"><h2>Lagrede forslag til gjennomgang</h2><span>@_forslag.Count åpne · budsjettår @_maalaar</span></div>
    <p class="hint">Datoene nedenfor er de lagrede forslagene. Endringer i de midlertidige datoene tas inn når du velger Generér. Synligheten foreslås fra fjorårets godkjente frist i samme løp, ellers fra standardregelen. POL velges alltid aktivt.</p>
    @if (_forslag.Count == 0) { <div class="tomgenerering"><h3>Ingen genererte forslag til gjennomgang for @_maalaar.</h3><p>Kontroller malen og velg Generér for å opprette forslag for dette året.</p></div> }
    @foreach (var gruppe in _forslag.GroupBy(f => Visningformat.KategoriNavn(f.Kategori)))
    {
        <section class="kildegruppe genereringsgruppe"><h3>@gruppe.Key <span>@gruppe.Count() forslag</span></h3>
            @foreach (var f in gruppe)
            {
                var t = Tilstand(f);
                <article @key="f.ForslagId" class="kort genereringskort" data-forslag-id="@f.ForslagId">
                    <header class="kort-topp"><span class="merke">Generert</span>@if (f.Tentativ) { <span class="merke merke-tentativ">Tentativ</span> }@if (f.Valgaarsflagg) { <span class="merke merke-valgaar">Valgår i datoens kalenderår</span> }</header>
                    <h3>@f.Tittel</h3>
                    <dl class="kort-felter">
                        <div><dt>Ny dato</dt><dd><time datetime="@Maskindato(f.Dato, f.Datopresisjon)">@FormatDato(f.Dato, f.Datopresisjon, f.Datokvalifikator)@(f.Tentativ ? " (tentativ)" : "")</time></dd></div>
                        <div><dt>Fjorårets dato @(_maalaar > 1 ? $"· budsjettår {_maalaar - 1}" : "")</dt><dd>@if (f.FjoraarDato is null) { <span>Ingen godkjent frist i samme løp</span> } else { <time datetime="@Maskindato(f.FjoraarDato, f.FjoraarDatopresisjon ?? Datopresisjon.Dag)">@FormatDato(f.FjoraarDato, f.FjoraarDatopresisjon ?? Datopresisjon.Dag, f.FjoraarDatokvalifikator)</time> }</dd></div>
                        <div><dt>Kategori og løp</dt><dd>@Visningformat.KategoriNavn(f.Kategori) · @(f.Loep ?? "Ikke angitt")</dd></div>
                        <div><dt>Foreslått synlig for</dt><dd>@(f.ForeslaattSynlighet.Count == 0 ? "Ingen" : string.Join(", ", f.ForeslaattSynlighet)) <small>@(f.FjoraarDato is not null ? "Fra fjorårets godkjente frist. Tidligere eller inaktive grupper er kun opphav; velg aktive grupper nedenfor." : "Fra standardregelen, uten POL.")</small></dd></div>
                    </dl>
                    @if (t.Feil is not null) { <div class="feil" role="alert">@t.Feil</div> }
                    @if (t.Modus == Kortmodus.Godkjenn)
                    {
                        <fieldset class="synlighet" disabled="@Opptatt"><legend>Velg synlighet (POL settes kun ved aktivt valg)</legend>@foreach (var grp in _grupper) { <label class="filtervalg @(grp.Kode == Pol ? "pol-valg" : "")"><input type="checkbox" @bind:get="t.Koder.Contains(grp.Kode)" @bind:set="paa => VekslKode(t, grp.Kode, paa)" />@grp.Navn (@grp.Kode)</label> }</fieldset>
                        @if (f.Tentativ) { <label class="filtervalg"><input type="checkbox" disabled="@Opptatt" @bind="t.TentativBekreftet" />Jeg bekrefter å godkjenne fristen uten en fastsatt dag (tentativ).</label> }
                        <div class="kort-handlinger"><button class="knapp knapp-primær" disabled="@(Opptatt || (f.Tentativ && !t.TentativBekreftet))" @onclick="() => Godkjenn(f, t)">@(t.Arbeider ? "Godkjenner …" : "Bekreft godkjenning")</button><button class="knapp" disabled="@Opptatt" @onclick="() => AvbrytKort(t)">Avbryt</button></div>
                    }
                    else if (t.Modus == Kortmodus.Avvis)
                    {
                        <label>Begrunnelse (valgfri)<textarea disabled="@Opptatt" @bind="t.Begrunnelse" rows="2"></textarea></label><div class="kort-handlinger"><button class="knapp knapp-primær" disabled="@Opptatt" @onclick="() => Avvis(f, t)">@(t.Arbeider ? "Avviser …" : "Bekreft avvisning")</button><button class="knapp" disabled="@Opptatt" @onclick="() => AvbrytKort(t)">Avbryt</button></div>
                    }
                    else
                    {
                        <div class="kort-handlinger"><button class="knapp knapp-primær" disabled="@Opptatt" @onclick="() => StartGodkjenn(f, t)">Godkjenn</button><button class="knapp" disabled="@Opptatt" @onclick="() => Juster(f)">Juster</button><button class="knapp" disabled="@Opptatt" @onclick="() => StartAvvis(f, t)">Avvis</button></div>
                    }
                </article>
            }
        </section>
    }
}
<dialog @ref="_erstattDialog" class="genereringsdialog" aria-labelledby="erstatt-tittel" data-visning="@Dialogvisning" data-bekreft="@(_bekrefter ? "true" : "false")" data-arbeider="@(_arbeider ? "true" : "false")">
    <h2 id="erstatt-tittel">Erstatt åpne genererte forslag?</h2><p>@_forslag.Count åpne genererte forslag for @_maalaar erstattes med den gyldige delmengden fra den lagrede malen.</p><p>Årets åpne genererte forslag erstattes; godkjente frister, løpende forslag og andre år beholdes.</p>
    @if (_rader.All(r => r.ErFeil)) { <p class="feil">Kontrollen har ingen gyldige regler. En vellykket kjøring erstatter årets sett med null åpne genererte forslag.</p> }
    <p>Avbryt beholder forslagene og de midlertidige datoene dine.</p><div class="kort-handlinger"><button class="knapp knapp-primær" autofocus disabled="@_arbeider" @onclick="AvbrytErstatningAsync">Avbryt</button><button class="knapp" disabled="@_arbeider" @onclick="BekreftErstatningAsync">Beregn og erstatt</button></div>
</dialog>
