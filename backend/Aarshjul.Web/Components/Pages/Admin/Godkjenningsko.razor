@page "/admin/ko"
@using Microsoft.AspNetCore.WebUtilities
@attribute [Authorize(Policy = Autorisasjon.ErAdministrator)]
@inject IGodkjenningsko Ko
@inject IGruppetjeneste Grupper
@inject NavigationManager Nav
@inject Aarshjul.Web.Visning.KoJusteringsretur Justeringsretur
@inject TimeProvider Klokke

<PageTitle>Godkjenningskø</PageTitle>

<Arbeidsaarvelger Aar="_arbeidsaar" AarChanged="ByttAar" />

<h1>Godkjenningskø</h1>

@if (LagretAar is { } lagret)
{
    <p class="melding" role="status">Fristen er lagret i budsjettår @lagret.
        <a href="@Arbeidsaarkontekst.Lenke("/admin/frister", lagret)">Åpne fristregisteret for @lagret</a>
    </p>
}

@if (_andreAar.Count > 0)
{
    <aside class="andre-arbeidsaar" aria-label="Åpne forslag i andre budsjettår">
        <h2>Forslag i andre år</h2>
        <p>Disse forslagene venter uavhengig av filtrene nedenfor. Snarveien åpner alle forslag i det valgte året.</p>
        <div class="aarsnarveier">
            @foreach (var annet in _andreAar)
            {
                <a href="@Arbeidsaarkontekst.Lenke("/admin/ko", annet.Aar)" @onclick="() => AapneAnnetAar(annet.Aar)" @onclick:preventDefault="true">@annet.Aar: @annet.Antall åpne forslag</a>
            }
        </div>
    </aside>
}

<div class="filterpanel">
    <label>Kilde eller innsender
        <select @bind="_kilde" @bind:after="LastAsync">
            <option value="">Alle</option>
            @foreach (var kilde in _kilder)
            {
                <option value="@kilde">@kilde</option>
            }
            @if (!string.IsNullOrWhiteSpace(_kilde) && !_kilder.Contains(_kilde))
            {
                <option value="@_kilde">@_kilde</option>
            }
        </select>
    </label>
    <label>Opphav
        <select @bind="_opphav" @bind:after="LastAsync">
            <option value="">Alle</option>
            <option value="@Opphav.Robot">Robot</option>
            <option value="@Opphav.Bruker">Bruker</option>
        </select>
    </label>
    <label>Type
        <select @bind="_type" @bind:after="LastAsync">
            <option value="">Alle</option>
            <option value="@ForslagType.NyFrist">Ny frist</option>
            <option value="@ForslagType.Endring">Endring</option>
        </select>
    </label>
    <label>Kategori
        <select @bind="_kategori" @bind:after="LastAsync">
            <option value="">Alle</option>
            <option value="@Kategori.Budsjett">Budsjett</option>
            <option value="@Kategori.Gulbok">Gul bok</option>
            <option value="@Kategori.Regnskap">Regnskap</option>
        </select>
    </label>
    <label class="filtervalg">
        <input type="checkbox" @bind="_kunUkjent" @bind:after="LastAsync" /> Kun «ukjent type»
    </label>
</div>

@if (!_lastet)
{
    <p class="melding">Laster …</p>
}
else if (_elementer.Count == 0)
{
    <p class="melding">Ingen forslag til behandling.</p>
}
else
{
    @foreach (var gruppe in _elementer.GroupBy(e => e.KildeEllerInnsender ?? "(ukjent kilde)"))
    {
        <section class="kildegruppe">
            <h2>@gruppe.Key</h2>
            @foreach (var e in gruppe)
            {
                var t = Tilstand(e);
                <article class="kort @(e.ErUkjentType ? "kort-ukjent" : "")">
                    <header class="kort-topp">
                        <span class="merke merke-@e.Opphav.ToString().ToLowerInvariant()">@OpphavNavn(e.Opphav)</span>
                        <span class="merke">@TypeNavn(e.ForslagType)</span>
                        @if (e.ErUkjentType)
                        {
                            <span class="merke merke-ukjent">Ukjent type</span>
                        }
                    </header>

                    <h3>@e.Tittel</h3>
                    <dl class="kort-felter">
                        <div><dt>Dato</dt><dd>@FormatDato(e)</dd></div>
                        <div><dt>Budsjettår</dt><dd>@e.Budsjettaar</dd></div>
                        <div><dt>Kategori</dt><dd>@Visningformat.KategoriNavn(e.Kategori)</dd></div>
                        @if (!string.IsNullOrWhiteSpace(e.Loep))
                        {
                            <div><dt>Løp</dt><dd>@e.Loep</dd></div>
                        }
                        @if (e.ForslagType != ForslagType.Endring)
                        {
                            <div><dt>Foreslått synlig for</dt>
                                <dd>@(e.ForeslaattSynlighet.Count == 0 ? "(ingen)" : string.Join(", ", e.ForeslaattSynlighet))</dd></div>
                        }
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(e.Notat))
                    {
                        <p class="kort-notat">@e.Notat</p>
                    }

                    @if (e.Gjeldende is { } g)
                    {
                        <div class="endring">
                            <strong>Endrer publisert frist:</strong>
                            <span>«@g.Tittel», @g.Dato.ToString("dd.MM.yyyy"), synlig for @string.Join(", ", g.Synlighet)</span>
                        </div>
                    }

                    <Uttrekksbevis Bevis="e.Bevis" />

                    @if (t.Feil is not null)
                    {
                        <div class="feil">@t.Feil</div>
                    }

                    @if (t.Modus == Kortmodus.Godkjenn)
                    {
                        @if (e.ForslagType == ForslagType.Endring)
                        {
                            <p class="melding">Synligheten på fristen står uendret — et endringsforslag rører kun innholdet.</p>
                        }
                        else
                        {
                            <fieldset class="synlighet">
                                <legend>Velg synlighet (POL settes kun ved aktivt valg)</legend>
                                @foreach (var grp in _grupper)
                                {
                                    <label class="filtervalg @(grp.Kode == Pol ? "pol-valg" : "")">
                                        <input type="checkbox"
                                               @bind:get="t.Koder.Contains(grp.Kode)"
                                               @bind:set="på => VekslKode(t, grp.Kode, på)" />
                                        @grp.Navn (@grp.Kode)
                                    </label>
                                }
                            </fieldset>
                        }
                        <div class="kort-handlinger">
                            <button class="knapp knapp-primær" disabled="@t.Arbeider" @onclick="() => Godkjenn(e, t)">Bekreft godkjenning</button>
                            <button class="knapp" disabled="@t.Arbeider" @onclick="() => t.Modus = Kortmodus.Ingen">Avbryt</button>
                        </div>
                    }
                    else if (t.Modus == Kortmodus.Avvis)
                    {
                        @* Begrunnelse gir bare mening for bidragsyter-forslag: den blir et varsel til
                           innsenderen. Robot-/opplastede forslag har ingen innsender å varsle, så feltet
                           vises ikke der (endring #3). *@
                        @if (e.Opphav == Opphav.Bruker)
                        {
                            <label>Begrunnelse (valgfri)
                                <textarea @bind="t.Begrunnelse" rows="2"></textarea>
                            </label>
                        }
                        <div class="kort-handlinger">
                            <button class="knapp knapp-primær" disabled="@t.Arbeider" @onclick="() => Avvis(e, t)">Bekreft avvisning</button>
                            <button class="knapp" disabled="@t.Arbeider" @onclick="() => t.Modus = Kortmodus.Ingen">Avbryt</button>
                        </div>
                    }
                    else
                    {
                        <div class="kort-handlinger">
                            <button class="knapp knapp-primær" @onclick="() => StartGodkjenn(e, t)">Godkjenn</button>
                            <button class="knapp" @onclick="() => Juster(e)">@(e.ErUkjentType ? "Vurder" : "Juster")</button>
                            <button class="knapp" @onclick="() => t.Modus = Kortmodus.Avvis">Avvis</button>
                        </div>
                    }
                </article>
            }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "aar")] public string? AarQuery { get; set; }
    [SupplyParameterFromQuery(Name = "kilde")] public string? KildeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "lagretAar")] public int? LagretAar { get; set; }
    private const string Pol = "POL";

    private IReadOnlyList<Koelement> _elementer = [];
    private IReadOnlyList<string> _kilder = [];
    private IReadOnlyList<GruppeDto> _grupper = [];
    private readonly Dictionary<Guid, Korttilstand> _tilstand = new();
    private bool _lastet;
    private bool _harJusteringsretur, _queryLastet;
    private string? _sisteKildeQuery;
    private int? _arbeidsaar;
    private int _versjon;
    private IReadOnlyList<(int Aar, int Antall)> _andreAar = [];

    // Filtervalg (tomme strenger = «alle»).
    private string _kilde = "";
    private string _opphav = "";
    private string _type = "";
    private string _kategori = "";
    private bool _kunUkjent;

    protected override async Task OnInitializedAsync()
    {
        if (Justeringsretur.Hent() is { } retur)
        {
            _harJusteringsretur = true;
            _kilde = retur.Kilde ?? "";
            _opphav = retur.Opphav?.ToString() ?? "";
            _type = retur.ForslagType?.ToString() ?? "";
            _kategori = retur.Kategori?.ToString() ?? "";
            _kunUkjent = retur.UkjentType == true;
        }
        _grupper = await Grupper.HentAktiveAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Engangsreturen bevarer også øvrige køfiltre. En ny URL kan avgrense på
        // eksakt kilde uten å endre tjenestens eksisterende snittsemantikk.
        if (!_queryLastet || !string.Equals(KildeQuery, _sisteKildeQuery, StringComparison.Ordinal))
        {
            if (!_harJusteringsretur) _kilde = KildeQuery ?? "";
            _sisteKildeQuery = KildeQuery;
            _queryLastet = true;
        }
        _harJusteringsretur = false;
        _arbeidsaar = Arbeidsaarkontekst.Les(AarQuery, Klokke);
        _elementer = [];
        _tilstand.Clear();
        _lastet = false;
        await LastAsync();
    }

    private async Task LastAsync()
    {
        var filter = LagFilter();
        var versjon = ++_versjon;
        // Valglisten kommer fra hele den åpne køen, uavhengig av de aktive filtrene.
        // Behold også aktivt valg når siste treff er behandlet, så tomt utvalg er synlig.
        var heleKoen = await Ko.HentKoAsync();
        var elementer = await Ko.HentKoAsync(filter);
        if (versjon != _versjon) return;
        _andreAar = heleKoen.Where(e => filter.Budsjettaar is { } aar && e.Budsjettaar != aar)
            .GroupBy(e => e.Budsjettaar).OrderBy(g => g.Key).Select(g => (g.Key, g.Count())).ToList();
        _kilder = heleKoen
            .Select(e => e.KildeEllerInnsender)
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Select(k => k!)
            .Distinct(StringComparer.Ordinal)
            .Order(StringComparer.Ordinal)
            .ToList();
        _elementer = elementer;
        _tilstand.Clear();
        _lastet = true;
    }

    private Kofilter LagFilter() => new()
    {
        Budsjettaar = _arbeidsaar,
        Kilde = _kilde,
        Opphav = Enum.TryParse<Opphav>(_opphav, out var o) ? o : null,
        ForslagType = Enum.TryParse<ForslagType>(_type, out var ft) ? ft : null,
        Kategori = Enum.TryParse<Kategori>(_kategori, out var k) ? k : null,
        UkjentType = _kunUkjent ? true : null
    };

    private void ByttAar(int? aar)
    {
        var lenke = Arbeidsaarkontekst.Lenke("/admin/ko", aar);
        Nav.NavigateTo(string.IsNullOrEmpty(_kilde) ? lenke : QueryHelpers.AddQueryString(lenke, "kilde", _kilde));
    }

    private void AapneAnnetAar(int aar)
    {
        _kilde = _opphav = _type = _kategori = "";
        _kunUkjent = false;
        ByttAar(aar);
    }

    private Korttilstand Tilstand(Koelement e) =>
        _tilstand.TryGetValue(e.Id, out var t) ? t : _tilstand[e.Id] = new Korttilstand();

    private void StartGodkjenn(Koelement e, Korttilstand t)
    {
        // Endringsforslag rører ikke synlighet; for nye/genererte forslag forhåndsutfylles
        // aktiv foreslått synlighet, men ALDRI POL (settes kun ved aktivt valg).
        t.Koder = e.ForslagType == ForslagType.Endring
            ? []
            : e.ForeslaattSynlighet
                .Where(k => !string.Equals(k, Pol, StringComparison.OrdinalIgnoreCase) && _grupper.Any(g => g.Kode == k))
                .ToHashSet();
        t.Feil = null;
        t.Modus = Kortmodus.Godkjenn;
    }

    private void VekslKode(Korttilstand t, string kode, bool på)
    {
        if (på) t.Koder.Add(kode);
        else t.Koder.Remove(kode);
    }

    private void Juster(Koelement e)
    {
        Justeringsretur.Bevar(e.Id, LagFilter());
        Nav.NavigateTo(Arbeidsaarkontekst.Lenke($"/admin/frist/juster/{e.Id}", _arbeidsaar));
    }

    private async Task Godkjenn(Koelement e, Korttilstand t)
    {
        if (t.Arbeider) return;
        t.Arbeider = true;
        t.Feil = null;
        try
        {
            // Endringsforslag sender ingen synlighet — fristens synlig_for står uendret (håndheves i tjenesten).
            await Ko.GodkjennAsync(new GodkjennInndata
            {
                ForslagId = e.Id,
                Synlighetskoder = e.ForslagType == ForslagType.Endring ? [] : t.Koder.ToList(),
                PolBekreftet = e.ForslagType != ForslagType.Endring && t.Koder.Contains(Pol)
            });
            await LastAsync();
        }
        catch (Valideringsfeil f)
        {
            t.Feil = f.Message;
        }
        finally { t.Arbeider = false; }
    }

    private async Task Avvis(Koelement e, Korttilstand t)
    {
        if (t.Arbeider) return;
        t.Arbeider = true;
        t.Feil = null;
        try
        {
            await Ko.AvvisAsync(e.Id, string.IsNullOrWhiteSpace(t.Begrunnelse) ? null : t.Begrunnelse);
            await LastAsync();
        }
        catch (Valideringsfeil f)
        {
            t.Feil = f.Message;
        }
        finally { t.Arbeider = false; }
    }

    private static string FormatDato(Koelement e)
    {
        if (e.Dato is not { } d) return "(ingen dato)";
        if (e.Datopresisjon == Datopresisjon.Maaned)
        {
            var maaned = d.ToString("MMMM yyyy");
            return e.Datokvalifikator is { } kv ? $"{kv.ToString().ToLowerInvariant()} {maaned} (tentativ)" : $"{maaned} (tentativ)";
        }
        return d.ToString("dd.MM.yyyy");
    }

    private static string OpphavNavn(Opphav o) => o switch
    {
        Opphav.Robot => "Robot", Opphav.Bruker => "Bruker", _ => "Admin"
    };

    private static string TypeNavn(ForslagType t) => t switch
    {
        ForslagType.Endring => "Endringsforslag", ForslagType.Generert => "Generert", _ => "Ny frist"
    };

    private enum Kortmodus { Ingen, Godkjenn, Avvis }

    private sealed class Korttilstand
    {
        public Kortmodus Modus { get; set; } = Kortmodus.Ingen;
        public HashSet<string> Koder { get; set; } = [];
        public string? Begrunnelse { get; set; }
        public string? Feil { get; set; }
        public bool Arbeider { get; set; }
    }
}
