@page "/admin/data"
@attribute [Authorize(Policy = Autorisasjon.ErAdministrator)]

<PageTitle>Eksporter / importer data</PageTitle>
<NavigationLock OnBeforeInternalNavigation="FoerNavigasjon" />
<div @ref="_flate" data-valg="@_valg" class="dataflate">
    <p class="menyoverskrift">Eksport og deling</p>
    <h1>Eksporter / importer data</h1>
    <p class="ingress">Ta vare på hele fristdatabasen. Kontroller en faktisk JSON-fil før du bekrefter at den skal erstatte alle frister.</p>
    <section class="fristoverfoering" aria-labelledby="frister-data">
        <h2 id="frister-data">Frister</h2>
        <div class="overfoervalg">
            <div class="overfoerkort">
                <span class="trinnmerke" aria-hidden="true">↓</span><h3>Last ned fristdatabasen</h3>
                <p>Alle lagrede frister, med status, opphav, innsender, kilder, dokumentkoblinger og synlighet. Gruppene og perioden på Eksporter gjelder ikke denne sikkerhetskopien.</p>
                <a class="knapp" href="/api/eksport/frister-json" download>Last ned frister (JSON)</a>
                <small>JSON, formatversjon 1. Ta en kopi før du erstatter innholdet.</small>
            </div>
            <div class="overfoerkort">
                <span class="trinnmerke" aria-hidden="true">↑</span><h3>Åpne en fristfil</h3>
                <p>Filvalg og forhåndsvisning endrer ingen lagrede frister.</p>
                <label for="fristfil">Fil (JSON)</label>
                <InputFile @key="_filfelt" id="fristfil" OnChange="VelgFil" accept=".json" disabled="@_lagrer" aria-describedby="fristfil-hjelp" />
                <small id="fristfil-hjelp">En fristdatabase i JSON, maks 25 MB.</small>
                @if (_navn is not null) { <p class="filnavn">Valgt fil: <strong>@_navn</strong> (@_storrelse)</p> }
                <button class="knapp" @onclick="ForhaandsvisAsync" disabled="@(_fil is null || _leser || _kontrollerer || _lagrer)">@(_leser ? "Leser og kontrollerer …" : "Forhåndsvis frister")</button>
            </div>
        </div>
        <p class="avgrensning">Dette gjenoppretter filens statuser og synlighet. Filer kan også inneholde upubliserte frister. Internkalender, brukere, abonnementer og faseinndeling inngår ikke.</p>
        @if (_leser || _kontrollerer) { <p class="overfoerstatus" role="status">@(_leser ? "Leser og kontrollerer fristfila …" : "Oppdaterer konsekvensen før bekreftelse …")</p> }
        @if (_status is not null) { <p class="overfoerstatus" role="status">@_status</p> }
        @if (_feil is not null) { <div id="fristimport-feil" class="feil" tabindex="-1" role="alert">@_feil</div> }
        @if (_resultat is { } resultat)
        {
            <section id="fristimport-kvittering" class="overfoerkvittering" tabindex="-1" aria-labelledby="fristimport-ferdig" role="status">
                <h3 id="fristimport-ferdig">Fristdatabasen er erstattet</h3>
                <p>Importerte <strong>@resultat.AntallImportert</strong> frister (erstattet @resultat.AntallErstattet).</p>
                @if (resultat.Advarsler.Count > 0) { <ul>@foreach (var advarsel in resultat.Advarsler) { <li>@advarsel</li> }</ul> }
                <a class="knapp" href="/admin/frister">Se fristregisteret</a>
            </section>
        }
        @if (_preview is { } preview)
        {
            <section class="importpreview" aria-label="Importforhåndsvisning" aria-busy="@(_lagrer ? "true" : "false")">
                <div class="previewtopp"><div><p class="menyoverskrift">Kontroller før du erstatter</p><h3 id="fristimport-preview" tabindex="-1">Forhåndsvisning av fristfil</h3><p class="filnavn">@_navn · @_storrelse · Fristdatabase versjon @(_database?.Versjon)</p></div><span class="previewmerke">Ingenting er lagret</span></div>
                <div class="importantall"><p><strong>@preview.Frister.Count</strong> frister tas inn</p><p><strong>@preview.EksisterendeAntall</strong> eksisterende frister erstattes</p><p><strong>@preview.Advarsler.Count</strong> advarsler</p></div>
                <div class="erstattkonsekvens @(preview.Frister.Count == 0 ? "tomkonsekvens" : null)">
                    @if (preview.Frister.Count == 0) { <h4>Fristdatabasen blir tom</h4><p>Alle @preview.EksisterendeAntall eksisterende frister fjernes og erstattes med null frister.</p> }
                    else { <h4>Alle frister erstattes</h4><p>Alle @preview.EksisterendeAntall eksisterende frister erstattes av @preview.Frister.Count frister fra fila. Frister som ikke er med, fjernes.</p> }
                    <p>Antallet er lest nå. Importen erstatter hele fristdatabasen slik den er ved gjennomføring.</p>
                </div>
                @if (preview.Advarsler.Count > 0) { <div class="importadvarsler"><h4>Advarsler om synlighet</h4><ul>@foreach (var advarsel in preview.Advarsler) { <li>@advarsel</li> }</ul></div> }
                <div class="importfrister">
                    @foreach (var frist in preview.Frister)
                    {
                        <article class="importfrist">
                            <span class="importkategori">@Visningformat.KategoriNavn(frist.Kategori) · Budsjettår @frist.Budsjettaar</span><h4>@frist.Tittel</h4>
                            <p>@Visningformat.FormatDato(frist.Dato, frist.Datopresisjon, frist.Datokvalifikator, frist.Klokkeslett)@(frist.Datopresisjon != Datopresisjon.Dag ? " (tentativ)" : "")</p>
                            <p>Status: <strong>@frist.Status</strong> · Synlighet: <strong>@(frist.SynligFor.Count == 0 ? "Ingen grupper" : string.Join(", ", frist.SynligFor))</strong></p>
                            <details><summary>Alle overførte felt</summary><dl class="importfelter">
                                <dt>ID</dt><dd>@(frist.Id == Guid.Empty ? "Ny ID ved import" : frist.Id.ToString())</dd>
                                <dt>Dato og presisjon</dt><dd>@frist.Dato.ToString("yyyy-MM-dd") · @frist.Datopresisjon · @frist.Datokvalifikator</dd>
                                <dt>Klokkeslett</dt><dd>@(frist.Klokkeslett?.ToString("HH:mm") ?? "Ingen")</dd>
                                <dt>Løp</dt><dd>@frist.Loep</dd><dt>Kilde</dt><dd>@frist.Kilde</dd><dt>Dokument-ID</dt><dd>@frist.DokumentId</dd>
                                <dt>Opphav</dt><dd>@frist.Opphav</dd><dt>Innsender</dt><dd>@frist.ForeslaattAv</dd><dt>Notat</dt><dd>@frist.Notat</dd><dt>Gjentaksregel-ID</dt><dd>@frist.GjentaRegelId</dd>
                            </dl></details>
                        </article>
                    }
                </div>
                <div class="overfoerhandlinger previewhandlinger"><button id="erstatt-frister" class="knapp knapp-primær" disabled="@(_leser || _kontrollerer || _lagrer)" @onclick="BeOmBekreftelseAsync">Importer frister (erstatt alt)</button><button class="knapp" disabled="@_lagrer" @onclick="AvbrytAsync">Avbryt</button></div>
            </section>
        }
        else if (_leser || _fil is not null) { <button class="knapp" @onclick="AvbrytAsync">Avbryt</button> }
        <dialog @key="_valg" @ref="_dialog" class="importdialog" aria-labelledby="fristimport-bekreft" data-valg="@_valg" data-bekreft="@(_bekreftelse ? "true" : "false")" data-arbeider="@(_lagrer ? "true" : "false")">
            @if (_preview is { } bekreft)
            {
                var bekreftetValg = _valg;
                <p class="menyoverskrift">Bekreft dataoverføring</p><h2 id="fristimport-bekreft">Erstatt alle frister?</h2>
                <p>Fil: <strong>@_navn</strong></p>
                @if (bekreft.Frister.Count == 0) { <p>Alle @bekreft.EksisterendeAntall eksisterende frister fjernes. 0 nye frister legges inn. Fristdatabasen blir tom.</p> }
                else { <p>Alle @bekreft.EksisterendeAntall eksisterende frister erstattes av @bekreft.Frister.Count frister fra fila, med status og synlighet som vist.</p> }
                <p>@bekreft.Advarsler.Count advarsler om ukjente grupper. Dette kan ikke angres her. En sikkerhetskopi kan importeres på nytt.</p>
                <div class="overfoerhandlinger"><button class="knapp" autofocus disabled="@_lagrer" @onclick="AvbrytAsync">Avbryt</button><button class="knapp knapp-primær" disabled="@_lagrer" @onclick="() => ImporterAsync(bekreftetValg)">@(_lagrer ? "Importerer …" : "Ja, erstatt alt")</button></div>
            }
        </dialog>
    </section>
    <section class="maloverfoering" aria-labelledby="aarsmal-data">
        <h2 id="aarsmal-data">Årsmal (gjentaksregler)</h2><p>Last ned alle gjentaksregler, eller åpne samme maloverføring under Årsmal for forhåndsvisning og bekreftet erstatning.</p>
        <div class="overfoerhandlinger"><a class="knapp" href="/api/eksport/maler-json" download>Last ned årsmal (JSON)</a><a class="knapp" href="/admin/mal/overfor">Overfør mal</a></div>
        <p class="hint">Faseinndelingen forvaltes separat under Administrator-innstillinger.</p>
    </section>
</div>
