@page "/admin/data"
@using System.Text.Json
@using Aarshjul.Application.Datautveksling
@using Aarshjul.Web.Api
@attribute [Authorize(Policy = Autorisasjon.ErAdministrator)]
@inject IFristDatautveksling Utveksling

<PageTitle>Eksporter / importer data</PageTitle>

<h1>Eksporter / importer data</h1>

<p class="melding">
    Last ned frister eller årsmaler som en JSON-«database», og last opp igjen senere for å
    gjenopprette. Dette er administratorfunksjoner. Import erstatter alt av den aktuelle typen.
</p>

<section class="skjema">
    <h2>Frister</h2>
    <p class="melding">Alle frister med synlighet, budsjettår, kategori, løp og notat.</p>
    <div class="skjemarad">
        <a class="knapp knapp-primær" href="/api/eksport/frister-json" download>Last ned frister (JSON)</a>
    </div>

    <div class="feil" role="note">
        <strong>Erstatter alt.</strong> Import fjerner alle eksisterende frister og legger inn dem fra
        fila. Ta gjerne en eksport først som sikkerhetskopi.
    </div>

    <label>Fil (JSON)
        <InputFile OnChange="VelgFristfil" accept=".json" />
    </label>

    @if (_fristNavn is not null)
    {
        <p class="melding">Valgt fil: <strong>@_fristNavn</strong> (@_fristStr)</p>
    }
    @if (_fristFeil is not null)
    {
        <div class="feil">@_fristFeil</div>
    }
    @if (_fristResultat is { } r)
    {
        <div class="melding">
            Importerte <strong>@r.AntallImportert</strong> frister (erstattet @r.AntallErstattet).
            @if (r.Advarsler.Count > 0)
            {
                <ul>@foreach (var a in r.Advarsler) { <li>@a</li> }</ul>
            }
        </div>
    }

    <div class="skjemarad">
        @if (!_fristBekreft)
        {
            <button class="knapp knapp-primær" @onclick="() => _fristBekreft = true" disabled="@(_fristFil is null || _fristArbeider)">
                Importer frister (erstatt alt)
            </button>
        }
        else
        {
            <span class="melding">Er du sikker? Dette fjerner alle eksisterende frister.</span>
            <button class="knapp knapp-primær" @onclick="ImporterFrister" disabled="@_fristArbeider">
                @(_fristArbeider ? "Importerer …" : "Ja, erstatt alt")
            </button>
            <button class="knapp" @onclick="() => _fristBekreft = false" disabled="@_fristArbeider">Avbryt</button>
        }
    </div>
</section>

<section class="skjema">
    <h2>Årsmal (gjentaksregler)</h2>
    <p>Last ned hele årsmalen, eller kontroller en malfil før du erstatter alle gjentaksreglene.</p>
    <a class="knapp" href="/admin/mal/overfor">Overfør mal</a>
    <p class="hint">Maloverføring har forhåndsvisning og egen bekreftelse under Årsmal.</p>
</section>
@code {
    private const long MaksStorrelse = 25 * 1024 * 1024; // 25 MB

    // --- Frister ---
    private IBrowserFile? _fristFil;
    private string? _fristNavn;
    private string? _fristStr;
    private ImportResultat? _fristResultat;
    private string? _fristFeil;
    private bool _fristArbeider;
    private bool _fristBekreft;

    private void VelgFristfil(InputFileChangeEventArgs e)
        => VelgFil(e, out _fristFil, out _fristNavn, out _fristStr, out _fristFeil, ref _fristBekreft, ref _fristResultat);

    private static void VelgFil(
        InputFileChangeEventArgs e, out IBrowserFile? fil, out string? navn, out string? str,
        out string? feil, ref bool bekreft, ref ImportResultat? resultat)
    {
        resultat = null;
        bekreft = false;
        feil = null;
        fil = e.File;
        navn = e.File.Name;
        str = $"{e.File.Size / 1024} kB";

        if (e.File.Size > MaksStorrelse)
        {
            feil = "Filen er for stor (maks 25 MB).";
            fil = null;
        }
        else if (!e.File.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        {
            feil = "Kun JSON-filer støttes.";
            fil = null;
        }
    }

    private async Task ImporterFrister()
    {
        if (_fristFil is null) { return; }
        _fristArbeider = true;
        _fristFeil = null;
        _fristResultat = null;
        try
        {
            var database = await Les<FristDatabase>(_fristFil);
            _fristResultat = await Utveksling.ImporterAsync(database);
            _fristBekreft = false;
        }
        catch (JsonException ex) { _fristFeil = $"Klarte ikke tolke JSON-fila: {ex.Message}"; }
        catch (Exception ex) { _fristFeil = $"Import feilet: {ex.Message}"; }
        finally { _fristArbeider = false; }
    }

    private static async Task<T> Les<T>(IBrowserFile fil)
    {
        using var ms = new MemoryStream();
        await fil.OpenReadStream(MaksStorrelse).CopyToAsync(ms);
        return JsonSerializer.Deserialize<T>(ms.ToArray(), FristEndepunkter.DatabaseJson)
               ?? throw new FormatException("Fila er tom eller ikke gyldig.");
    }
}
