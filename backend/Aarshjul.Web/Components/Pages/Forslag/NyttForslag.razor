@page "/forslag/ny"
@page "/forslag/{Id:guid}/rediger"
@page "/forslag/endre/{FristId:guid}"
@attribute [Authorize(Policy = Autorisasjon.ErBidragsyter)]
@inject NavigationManager Nav

<PageTitle>@Tittel</PageTitle>

<h1>@Tittel</h1>
<Forslagsskjema @key="(Id, FristId)" Id="Id" FristId="FristId" Sendt="TilMineForslag" Avbrutt="TilMineForslag" />

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public Guid? FristId { get; set; }

    private string Tittel => FristId is not null
        ? "Foreslå endring på en publisert frist"
        : Id is null ? "Foreslå en frist" : "Rediger og send inn på nytt";

    private void TilMineForslag() => Nav.NavigateTo("/forslag/mine");
}
