@page "/"
@page "/kalender"
@attribute [Authorize]
@implements IDisposable
@inject TimeProvider Klokke
@inject Kalendertilstand Tilstand
@inject IFristlesing Lesing
@inject Synlighetskontekstkilde Kontekstkilde

<PageTitle>Kalender</PageTitle>

<div class="leseskall kalenderskall">
    <aside class="leserfilter" aria-label="Fristutvalg" tabindex="-1" @ref="_utvalgsfilter">
        <p class="menyoverskrift">Din kalender</p>
        <Minikalender ValgtDato="_valgtDato" Idag="Idag" Frister="Maanedsfrister" DatoValgt="VelgDatoAsync" />
        @if (Tilstand.Visning == Kalenderpresentasjon.Liste)
        {
            <label class="maanedsvalg kalenderkontekstvalg">Vis måned<input type="month" min="0001-01" max="9999-12" value="@_valgtDato.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)" @onchange="VedMaanedsvalgAsync" /></label>
        }
        <h2>Velg utvalg</h2>
        <Kalenderfilter Tilstand="Tilstand" TilgjengeligeAar="TilgjengeligeAar" Endret="FiltreEndretAsync" />
        <div class="kalenderforklaring"><strong>Samme frister, ulike perspektiver</strong><p>Kalender viser datoene på tvers av valgte budsjettår. Budsjettår samler ett helt løp.</p></div>
    </aside>
    <div class="leseinnhold">
        <p class="menyoverskrift">Kalender</p>
        <h1>Kalender</h1>
        <p class="ingress">Se fristene i kalenderen, og behold oversikten over budsjettårene.</p>
        @if (Fjernet == "1")
        {
            <p class="melding" role="status">Fristen er fjernet. Kalenderen viser det relevante utvalget med din vanlige tilgang.</p>
        }
        @if (Tilstand.OverfoertFrist is { } overfoert)
        {
            <section class="kalenderovergang" aria-label="Overgang fra budsjettår">
                <strong>@overfoert.Tittel</strong>
                <p>@(overfoert.ErTentativ ? $"Åpnet {Kalendervisning.Maaned(overfoert.Dato)} · {Visningformat.FormatDato(overfoert)} · dato ikke fastsatt." : $"Åpnet {Visningformat.FormatDato(overfoert)}.") Kalenderens søk og kategorier er beholdt.</p>
                @if (SkjulesAvFiltre(overfoert))
                {
                    <p>Fristen skjules av kalenderutvalget: @Filterforklaring(overfoert). Endre utvalget for å vise fristen.</p>
                    <button class="knapp" @onclick="EndreKalenderutvalgAsync">Endre kalenderutvalg</button>
                }
                <button class="knapp-lenke" @onclick="() => Tilstand.OverfoertFrist = null">Lukk meldingen</button>
            </section>
        }
        <section class="kalenderutvalg" aria-label="Aktivt kalenderutvalg">
            <span><strong>@(Tilstand.Visning == Kalenderpresentasjon.Liste ? "Kalenderkontekst:" : "Periode:")</strong> @Periodetekst</span>
            <span><strong>Budsjettår:</strong> @(Tilstand.Budsjettaar.Count == 0 ? "Ingen valgt" : string.Join(", ", Tilstand.Budsjettaar.Order()))</span>
            <span><strong>Kategorier:</strong> @(Tilstand.Kategorier.Count == 0 ? "Ingen valgt" : string.Join(", ", Tilstand.Kategorier.Order().Select(Visningformat.KategoriNavn)))</span>
            @if (!string.IsNullOrWhiteSpace(Tilstand.Soek)) { <span><strong>Søk:</strong> «@Tilstand.Soek.Trim()»</span> }
        </section>
        <nav class="kalendervisninger" aria-label="Kalendervisning">
            @foreach (var (visning, navn) in Visninger)
            {
                <button aria-pressed="@(Tilstand.Visning == visning ? "true" : "false")" @onclick="() => ByttVisningAsync(visning)">@navn</button>
            }
        </nav>
        <section aria-label="@Visningsnavn" aria-busy="@(!Lastet ? "true" : "false")">
            @if (Tilstand.Visning == Kalenderpresentasjon.Liste)
            {
                <div class="kalenderliste-topp">
                    <h2 tabindex="-1" @ref="_listeoverskrift">@(Tilstand.VisListehistorikk ? "Tidligere hendelser" : "Kommende frister")</h2>
                    <p>@(Tilstand.VisListehistorikk ? $"Før {Kalendervisning.Dato(Tilstand.Listedato ?? Idag)}, seneste først. Tentative frister vises når måneden er over." : $"Fra og med {Kalendervisning.Dato(Tilstand.Listedato ?? Idag)}. Tentative frister vises til måneden er over.")</p>
                    <button class="knapp" disabled="@(!Lastet)" @onclick="VeksleHistorikkAsync">@(Tilstand.VisListehistorikk ? "Tilbake til kommende frister" : "Vis tidligere hendelser")</button>
                </div>
                @if (Lastet && Lastefeil is null && Tilstand.ListeOppdatert)
                {
                    <p class="melding" role="status">Utvalget er oppdatert. Frister, rekkefølge eller dagens dato er endret. Du er tilbake på side 1.</p>
                }
            }
            else
            {
            <nav class="maanedsnavigasjon" aria-label="@(Tilstand.Periode == Kalenderperiode.Maaned ? "Månedsnavigasjon" : "Ukenavigasjon")">
                <button class="knapp" @onclick="() => VelgDatoAsync(Idag)">I dag</button>
                <div class="periodepiler">
                    <button class="knapp" aria-label="@(Tilstand.Periode == Kalenderperiode.Maaned ? "Forrige måned" : "Forrige uke")" disabled="@(!KanFlytte(-1))" @onclick="() => FlyttAsync(-1)">‹</button>
                    <button class="knapp" aria-label="@(Tilstand.Periode == Kalenderperiode.Maaned ? "Neste måned" : "Neste uke")" disabled="@(!KanFlytte(1))" @onclick="() => FlyttAsync(1)">›</button>
                </div>
                <h2 class="@(Tilstand.Visning == Kalenderpresentasjon.Maaned ? null : "periodeoverskrift")">@Periodetekst</h2>
                <label class="maanedsvalg">Vis måned<input type="month" min="0001-01" max="9999-12" value="@_valgtDato.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)" @onchange="VedMaanedsvalgAsync" /></label>
            </nav>
            }
            @if (!Lastet)
            {
                <p class="melding" role="status">Laster frister …</p>
            }
            else if (Lastefeil is not null)
            {
                <div class="feil" role="alert">@Lastefeil <button class="knapp" @onclick="LastInnAsync">Prøv igjen</button></div>
            }
            else
            {
                <div class="aarsforklaring">
                    @foreach (var aar in Frister.Select(f => f.Budsjettaar).Distinct().Order())
                    {
                        <span class="@Visningformat.FargeklasseForAar(aar)"><i class="aarsprikk" aria-hidden="true"></i>Budsjettår @aar</span>
                    }
                </div>
                @foreach (var maaned in Frister.Where(f => f.ErTentativ && Tilstand.Visning != Kalenderpresentasjon.Liste).GroupBy(f => Kalendervisning.FoersteDag(f.Dato)).OrderBy(g => g.Key))
                {
                    <section class="tentative-maanedsfrister" aria-label="@($"Tentative frister i {Kalendervisning.Maaned(maaned.Key)}")">
                        <h3>@Kalendervisning.Maaned(maaned.Key) · Dato ikke fastsatt</h3>
                        @foreach (var frist in maaned.OrderBy(f => f.Sorteringsdag).ThenBy(f => f.Tittel))
                        {
                            <button class="tentativ-hendelse @Visningformat.FargeklasseForAar(frist.Budsjettaar)" data-frist-id="@frist.Id" aria-label="@frist.Tittel" @onclick="() => AapneFristAsync(frist)">
                                <strong>@frist.Tittel</strong><span>@Visningformat.FormatDato(frist) · Budsjettår @frist.Budsjettaar</span>
                            </button>
                        }
                    </section>
                }
                <div class="kalenderflate">
                    @if (Tilstand.Visning == Kalenderpresentasjon.Maaned)
                    {
                        <Maanedskalender ValgtDato="_valgtDato" Idag="Idag" Frister="Frister" AapneDag="AapneDagAsync" AapneFrist="AapneFristAsync" />
                    }
                    else if (Tilstand.Visning == Kalenderpresentasjon.Uke)
                    {
                        <Ukekalender ValgtDato="_valgtDato" Idag="Idag" Frister="Frister" AapneDag="AapneDagAsync" AapneFrist="AapneFristAsync" />
                    }
                    else
                    {
                        <Kalenderliste Frister="Frister" AapneFrist="AapneFristAsync" />
                    }
                    @if (Tilstand.Visning == Kalenderpresentasjon.Liste)
                    {
                        <nav class="listesider" aria-label="Sider med frister">
                            <button class="knapp" aria-label="Forrige side" disabled="@(Tilstand.Listeside <= 1)" @onclick="() => LastInnUtvalgAsync(-1)">‹ Forrige</button>
                            <p role="status">Side @(Tilstand.AntallListesider == 0 ? 0 : Tilstand.Listeside) av @Tilstand.AntallListesider · @Tilstand.AntallListefrister @(Tilstand.AntallListefrister == 1 ? "frist" : "frister")</p>
                            <button class="knapp" aria-label="Neste side" disabled="@(Tilstand.Listeside >= Tilstand.AntallListesider)" @onclick="() => LastInnUtvalgAsync(1)">Neste ›</button>
                        </nav>
                    }
                    else
                    {
                        <p class="kalenderstatus" role="status">@Frister.Count @(Frister.Count == 1 ? "frist" : "frister") i @(Tilstand.Periode == Kalenderperiode.Maaned ? "måneden" : "uken") · @Frister.Count(f => !f.ErTentativ) med fast dag</p>
                    }
                </div>
                @if (Frister.Count == 0) { <p class="melding">@(Tilstand.Visning == Kalenderpresentasjon.Liste ? (Tilstand.VisListehistorikk ? "Ingen tidligere hendelser i utvalget ditt." : "Ingen kommende frister i utvalget ditt.") : $"Ingen frister i utvalget ditt denne {(Tilstand.Periode == Kalenderperiode.Maaned ? "måneden" : "uken")}.")</p> }
                <p class="kalenderhint">@(Tilstand.Visning == Kalenderpresentasjon.Liste ? "Velg en frist for å lese detaljene. Minikalenderen beholder kalenderperioden din." : "Velg en dato for dagsagenda, eller en frist for å lese detaljene.")</p>
            }
        </section>
    </div>
</div>
<Fristdialog @ref="_fristdialog" Startbudsjettaar="@(Tilstand.Budsjettaar.Count == 1 ? Tilstand.Budsjettaar.Single() : (int?)null)" />

@code {
    [SupplyParameterFromQuery(Name = "aar")] public string? Lenkeaar { get; set; }
    [SupplyParameterFromQuery(Name = "kategori")] public string? Lenkekategori { get; set; }
    [SupplyParameterFromQuery(Name = "dato")] public string? Lenkedato { get; set; }
    [SupplyParameterFromQuery(Name = "fjernet")] public string? Fjernet { get; set; }
    private string? _bruktLenke;
    private int? _lenkeaar;
    private static readonly (Kalenderpresentasjon Visning, string Navn)[] Visninger =
        [(Kalenderpresentasjon.Maaned, "Måned"), (Kalenderpresentasjon.Uke, "Uke"), (Kalenderpresentasjon.Liste, "Liste")];
    private string Visningsnavn => Tilstand.Visning switch
    {
        Kalenderpresentasjon.Maaned => "Månedskalender", Kalenderpresentasjon.Uke => "Ukekalender", _ => "Kalenderliste"
    };
    private string Periodetekst => Kalendervisning.Periodetekst(_valgtDato, Tilstand.Periode);
    private DateOnly _valgtDato { get => Tilstand.ValgtDato ?? Idag; set => Tilstand.ValgtDato = value; }
    private Fristdialog _fristdialog = default!;
    private ElementReference _utvalgsfilter;
    private ElementReference _listeoverskrift;
    private bool _fokuserListe;
    private DateOnly Idag => Datohjelp.Idag(Klokke);
    private IReadOnlyList<FristDto> Frister = [];
    private IReadOnlyList<FristDto> Maanedsfrister = [];
    private IReadOnlyList<int> TilgjengeligeAar = [];
    private bool Lastet;
    private string? Lastefeil;
    private int _lasting;
    private bool _avsluttet;

    protected override Task OnInitializedAsync()
    {
        Tilstand.ValgtDato ??= Idag;
        return LastInnAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var nokkel = $"{Fjernet}|{Lenkeaar}|{Lenkekategori}|{Lenkedato}";
        if (nokkel == _bruktLenke) return;
        _bruktLenke = nokkel; _lenkeaar = null;
        if (Fjernet != "1" || !int.TryParse(Lenkeaar, out var aar) || aar is < 1 or > 9999
            || !int.TryParse(Lenkekategori, out var kategori) || !Enum.IsDefined((Kategori)kategori)
            || !DateOnly.TryParseExact(Lenkedato, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dato)) return;
        _lenkeaar = aar; Tilstand.Budsjettaar.Clear(); Tilstand.Budsjettaar.Add(aar);
        Tilstand.Kategorier.Clear(); Tilstand.Kategorier.Add((Kategori)kategori);
        Tilstand.Soek = ""; Tilstand.ValgtDato = dato;
        Tilstand.Periode = Kalenderperiode.Maaned;
        await LastInnAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_fokuserListe || !Lastet || Tilstand.Visning != Kalenderpresentasjon.Liste) return;
        _fokuserListe = false;
        await _listeoverskrift.FocusAsync();
    }

    private Task LastInnAsync() => LastInnUtvalgAsync();

    private Task VeksleHistorikkAsync()
    {
        Tilstand.VisListehistorikk = !Tilstand.VisListehistorikk;
        return LastInnAsync();
    }

    private Task FiltreEndretAsync()
    {
        Tilstand.NullstillListesider();
        return LastInnAsync();
    }

    private async Task LastInnUtvalgAsync(int sidesteg = 0)
    {
        var lasting = ++_lasting;
        Lastet = false;
        Frister = [];
        Maanedsfrister = [];
        try
        {
            var ctx = await Kontekstkilde.HentAsync();
            // Årsvalgene omfatter hele det autoriserte, godkjente utvalget, også historikk.
            var aar = await Lesing.HentTilgjengeligeBudsjettaarAsync(ctx, inkluderHistorikk: true);
            if (_avsluttet || lasting != _lasting) return;
            TilgjengeligeAar = _lenkeaar is { } lenkeaar ? aar.Append(lenkeaar).Distinct().Order().ToArray() : aar;
            Tilstand.InitialiserAar(aar);
            IReadOnlyList<FristDto> frister = [];
            var (fra, til) = Kalendervisning.Periode(_valgtDato, Tilstand.Periode);
            // Kalenderens eksplisitte tomme utvalg skal aldri oversettes til leseportens alle.
            if (Tilstand.Budsjettaar.Count > 0 && Tilstand.Kategorier.Count > 0)
                frister = await Lesing.HentSynligeAsync(ctx, new FristFilter
                {
                    Kategorier = Tilstand.Kategorier.ToArray(),
                    Budsjettaar = Tilstand.Budsjettaar.ToArray(),
                    // Hele berørte måneder er nødvendig for tentative frister, som
                    // ikke tilhører sin avledede sorteringsdag, og minikalenderen.
                    FraDato = Tilstand.Visning == Kalenderpresentasjon.Liste ? null : Kalendervisning.FoersteDag(fra),
                    TilDato = Tilstand.Visning == Kalenderpresentasjon.Liste ? null : Kalendervisning.SisteDag(til),
                    InkluderHistorikk = true
                });
            if (_avsluttet || lasting != _lasting) return;
            // Søk på serveren i det allerede autoriserte utvalget. Ingen usynlige
            // titler/notater eller tellinger sendes til nettleseren.
            var soek = Tilstand.Soek.Trim();
            Maanedsfrister = string.IsNullOrEmpty(soek) ? frister : frister.Where(f => TrefferSoek(f, soek)).ToArray();
            Frister = Tilstand.Visning == Kalenderpresentasjon.Liste
                ? Tilstand.HentListeside(Maanedsfrister, Idag, sidesteg)
                : Maanedsfrister.Where(f => f.ErTentativ || (f.Dato >= fra && f.Dato <= til)).ToArray();
            Lastefeil = null;
        }
        catch (Exception)
        {
            if (_avsluttet || lasting != _lasting) return;
            Frister = [];
            Maanedsfrister = [];
            Lastefeil = "Kunne ikke laste frister akkurat nå. Prøv igjen.";
        }
        Lastet = true;
        _fokuserListe = sidesteg != 0 && Lastefeil is null;
    }

    public void Dispose() => _avsluttet = true;

    private bool KanFlytte(int steg)
    {
        if (Tilstand.Periode == Kalenderperiode.Maaned) return Kalendervisning.KanFlytte(_valgtDato, steg);
        var (fra, til) = Kalendervisning.Periode(_valgtDato, Tilstand.Periode);
        return steg < 0 ? fra > DateOnly.MinValue : til < DateOnly.MaxValue;
    }

    private Task FlyttAsync(int steg) => VelgDatoAsync(Tilstand.Periode == Kalenderperiode.Maaned
        ? Kalendervisning.FoersteDag(_valgtDato).AddMonths(steg)
        : DateOnly.FromDayNumber(Math.Clamp(_valgtDato.DayNumber + steg * 7, DateOnly.MinValue.DayNumber, DateOnly.MaxValue.DayNumber)));

    private async Task ByttVisningAsync(Kalenderpresentasjon visning)
    {
        var forrigeVisning = Tilstand.Visning;
        Tilstand.Visning = visning;
        if (visning != Kalenderpresentasjon.Liste)
            Tilstand.Periode = visning == Kalenderpresentasjon.Maaned ? Kalenderperiode.Maaned : Kalenderperiode.Uke;
        if (forrigeVisning != visning) await LastInnAsync();
    }

    private async Task VelgDatoAsync(DateOnly dato)
    {
        var nyPeriode = Kalendervisning.Periode(dato, Tilstand.Periode) != Kalendervisning.Periode(_valgtDato, Tilstand.Periode);
        _valgtDato = dato;
        if (nyPeriode) await LastInnAsync();
    }

    private async Task VedMaanedsvalgAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var dato)) await VelgDatoAsync(dato);
    }

    private Task AapneDagAsync(DateOnly dato)
    {
        _valgtDato = dato;
        return _fristdialog.VisAgendaAsync(dato, Kalendervisning.Dagsfrister(Frister, dato));
    }
    private Task AapneFristAsync(FristDto frist) => _fristdialog.VisFristAsync(frist);

    private bool SkjulesAvFiltre(FristDto frist) => !Tilstand.Budsjettaar.Contains(frist.Budsjettaar)
        || !Tilstand.Kategorier.Contains(frist.Kategori) || !TrefferSoek(frist);

    private bool TrefferSoek(FristDto frist) => string.IsNullOrWhiteSpace(Tilstand.Soek)
        || TrefferSoek(frist, Tilstand.Soek.Trim());

    private static bool TrefferSoek(FristDto frist, string soek) =>
        frist.Tittel.Contains(soek, StringComparison.OrdinalIgnoreCase)
        || (frist.Notat?.Contains(soek, StringComparison.OrdinalIgnoreCase) ?? false);

    private string Filterforklaring(FristDto frist)
    {
        var grunner = new List<string>();
        if (!Tilstand.Budsjettaar.Contains(frist.Budsjettaar)) grunner.Add($"budsjettår {frist.Budsjettaar} er ikke valgt");
        if (!Tilstand.Kategorier.Contains(frist.Kategori)) grunner.Add($"kategorien {Visningformat.KategoriNavn(frist.Kategori)} er ikke valgt");
        if (!TrefferSoek(frist)) grunner.Add($"søket «{Tilstand.Soek.Trim()}» gir ikke treff");
        return string.Join("; ", grunner);
    }
    private async Task EndreKalenderutvalgAsync() => await _utvalgsfilter.FocusAsync();
}
