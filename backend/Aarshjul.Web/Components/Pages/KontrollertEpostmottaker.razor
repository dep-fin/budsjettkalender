@page "/demo/epostmottaker"
@attribute [Authorize]
@using Aarshjul.Infrastructure.Epost
@inject IServiceProvider Tjenester
@inject IConfiguration Konfigurasjon
@inject IWebHostEnvironment Miljoe
@inject Gjeldendebrukerkilde Brukerkilde

<PageTitle>Kontrollert testmottaker</PageTitle>
<h1>Kontrollert testmottaker</h1>
@if (!ErDemo)
{
    <p>Denne testmottakeren er bare tilgjengelig i lokal demo.</p>
}
else if (_melding is null)
{
    <p>Ingen bekreftelsesmelding for din innloggede bruker. Meldingen finnes bare frem til appen starter på nytt.</p>
}
else
{
    <p>Dette er lokal testtransport. Ingen ekstern e-post er sendt.</p>
    <p>Til: @_melding.Adresse</p>
    <h2>Bekreft din jobbadresse</h2>
    <p>Du har bedt om e-postvarsling. Lenken varer i 15 minutter, kan bare brukes én gang og krever at samme bruker er innlogget.</p>
    <a href="@("/epostvarsling/bekreft#" + _melding.Token)" data-enhance-nav="false" rel="noreferrer">Bekreft jobbadressen</a>
}
<p><a href="/epostvarsling">Til e-postvarsling</a></p>
@if (ErDemo)
{
    <h2>Daglige oppsummeringer</h2>
    @if (_oppsummeringer.Count == 0)
    {
        <p>Ingen oppsummeringer for din innloggede bruker i denne appkjøringen.</p>
    }
    @foreach (var melding in _oppsummeringer)
    {
        <article aria-label="Daglig oppsummering">
            <p>Til: @melding.Adresse</p>
            <pre>@melding.Tekst</pre>
            @((MarkupString)melding.Html)
        </article>
    }
}

@code {
    private Bekreftelsesmelding? _melding;
    private IReadOnlyList<Oppsummeringsmelding> _oppsummeringer = [];
    private bool ErDemo => Miljoe.IsDevelopment() && Konfigurasjon.GetValue<bool>("Demo") || Miljoe.IsEnvironment("Demo") || Miljoe.IsEnvironment("Testing");
    protected override async Task OnInitializedAsync()
    {
        if (ErDemo)
        {
            var id = (await Brukerkilde.HentAsync()).Id;
            _melding = Tjenester.GetRequiredService<KontrollertBekreftelsespost>().Hent(id);
            _oppsummeringer = Tjenester.GetRequiredService<KontrollertOppsummeringspost>().Hent(id);
        }
    }
}
