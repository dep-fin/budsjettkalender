@page "/internkalender/mine"
@using Aarshjul.Application.Internkalender
@inherits Internside
@attribute [Authorize(Policy = Autorisasjon.ErSbr)]
@inject IInternkalender Kalender
@inject Gjeldendebrukerkilde Brukerkilde

<PageTitle>Mine gjøremål (SBR)</PageTitle>
<InternkalenderOmraade>
    <h1>Mine gjøremål</h1>
    <p class="ingress">Dine aktive gjøremål på tvers av alle runder og Øvrig, sortert etter tidspunkt. Ansvar følger brukeren din; et fritekstnavn gir ikke eierskap.</p>
    @if (!_lastet) { <p class="melding" role="status">Laster gjøremål …</p> }
    else if (_feil is not null) { <div class="feil" role="alert"><p>@_feil</p><button class="knapp" @onclick="Last">Prøv igjen</button></div> }
    else if (_mine.Count == 0) { <div class="internkort"><h2>Ingen aktive gjøremål</h2><p>Du har ingen aktive gjøremål akkurat nå.</p><a href="/internkalender">Finn en internrunde</a></div> }
    else
    {
        <p class="hint">@_mine.Count aktive gjøremål</p>
        <table class="tabell"><thead><tr><th scope="col">Gjøremål</th><th scope="col">Runde</th><th scope="col">Tidspunkt</th><th scope="col">Ansvarlige</th></tr></thead><tbody>
        @foreach (var m in _mine)
        {
            <tr @key="m.Gjoeremaal.Id"><td data-label="Gjøremål"><a href="@($"/internkalender/gjoeremaal/{m.Gjoeremaal.Id}")"><strong class="oppgavetittel">@m.Gjoeremaal.Tittel</strong></a>@if (!string.IsNullOrWhiteSpace(m.Gjoeremaal.Notat)) { <div class="oppgavenotat">@m.Gjoeremaal.Notat</div> }</td><td data-label="Runde"><a href="@($"/internkalender/runde/{m.Gjoeremaal.RundeId}")">@m.RundeEtikett</a></td><td data-label="Tidspunkt">@m.Gjoeremaal.Tidsangivelse</td><td data-label="Ansvarlige">@string.Join(", ", m.Gjoeremaal.Ansvarlige.Select(a => a.Navn + (a.BrukerId is null ? " (fritekst)" : "")))</td></tr>
        }
        </tbody></table>
    }
</InternkalenderOmraade>
@code {
    private IReadOnlyList<MittGjoeremaalDto> _mine = [];
    private bool _lastet;
    private string? _feil;
    protected override Task OnInitializedAsync() => Last();
    private async Task Last()
    {
        var visning = ++Visning; _lastet = false; _feil = null;
        try { var bruker = await Brukerkilde.HentAsync(Levetid.Token); var data = await Kalender.HentMineAsync(bruker.Id, Levetid.Token); if (ErGjeldende(visning)) _mine = data; }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _feil = Feiltekst(e, "Kunne ikke laste dine gjøremål. Prøv igjen."); }
        finally { if (ErGjeldende(visning)) _lastet = true; }
    }
}
