@page "/internkalender/runde/{Id:guid}"
@using Aarshjul.Application.Internkalender
@inherits Internside
@attribute [Authorize(Policy = Autorisasjon.ErSbr)]
@inject IInternkalender Kalender
@inject InternkalenderKommando Kommando
@inject Gjeldendebrukerkilde Brukerkilde
@inject NavigationManager Nav
@inject InternkalenderRetur Retur

<PageTitle>@(_runde?.Etikett ?? "Internrunde")</PageTitle>
<NavigationLock OnBeforeInternalNavigation="FoerNavigasjon" />
<InternkalenderOmraade>
@if (!_lastet) { <h1>Internrunde</h1><p class="melding" role="status">Laster runden …</p> }
else if (_lastfeil is not null) { <h1>Internrunde</h1><div class="feil" role="alert"><p>@_lastfeil</p><button class="knapp" @onclick="Last">Prøv igjen</button></div> }
else if (_runde is null) { <h1>Runden finnes ikke</h1><p class="melding">Runden kan ha blitt slettet.</p><a href="/internkalender">Til oversikten</a> }
else
{
    <div class="admintopp">
        <div><h1>@_runde.Etikett</h1><p class="ingress">Følg opp interne gjøremål, ansvarlige og fullføring.</p></div>
        <div class="internhandlinger">
            @if (_runde.Rundetype != Rundetype.Ovrig) { <button class="knapp" disabled="@_arbeider" @onclick='() => Nav.NavigateTo($"/internkalender/runde/{_runde.Id}/synk")'>Synkroniser mot regler</button> }
            <a href="/internkalender">Til oversikten</a>
        </div>
    </div>
    @if (_melding is not null) { <p class="internstatus" role="status">@_melding</p> }
    @if (_feil is not null && _fullfoer is null && _slett is null) { <p class="feil" role="alert">@_feil</p> }
    <section class="internkort" aria-labelledby="hurtiginnlegging">
        <h2 id="hurtiginnlegging">Legg til et gjøremål</h2>
        <form @onsubmit="Hurtiglegg" @onsubmit:preventDefault="true">
            <div class="skjemarad">
                <label>Hurtiginnlegging (tittel er nok – fyll ut resten senere)<input @bind="_hurtigTittel" @bind:event="oninput" placeholder="Nytt gjøremål …" disabled="@_arbeider" /></label>
                <button type="submit" class="knapp knapp-primær" disabled="@(_arbeider || string.IsNullOrWhiteSpace(_hurtigTittel))">Legg til</button>
                <button type="button" class="knapp" disabled="@_arbeider" @onclick='() => Nav.NavigateTo($"/internkalender/gjoeremaal/ny/{_runde.Id}")'>Nytt gjøremål (fullt skjema)</button>
            </div>
        </form>
    </section>
    <div class="skjemarad"><label>Vis ansvarlig<select @bind="_filterBrukerId" @bind:after="Last" disabled="@_arbeider"><option value="">Alle</option>@if (_megId is not null) { <option value="@_megId">Kun mine</option> }@foreach (var a in _ansvarlige.Where(a => a.BrukerId is not null && a.BrukerId != _megId)) { <option value="@a.BrukerId">@a.Navn</option> }</select></label></div>
    <h2>Aktive (@_aktive.Count)</h2>
    @if (_aktive.Count == 0) { <p class="internkort">Ingen aktive gjøremål@(string.IsNullOrEmpty(_filterBrukerId) ? "" : " for valgt ansvarlig").</p> }
    else
    {
        <table class="tabell"><thead><tr><th scope="col" class="avhuking">Fullfør</th><th scope="col">Gjøremål</th><th scope="col">Tidspunkt</th><th scope="col">Ansvarlige</th><th scope="col">Handlinger</th></tr></thead><tbody>
        @foreach (var g in _aktive)
        {
            <tr @key="g.Id">
                <td class="avhuking"><input type="checkbox" @bind:get="@(_fullfoer?.Id == g.Id)" @bind:set="(bool valgt) => valgt ? StartFullfoer(g) : Task.CompletedTask" aria-label="@($"Fullfør {g.Tittel}")" disabled="@_arbeider" /></td>
                <td data-label="Gjøremål"><strong class="oppgavetittel">@g.Tittel</strong>@if (g.Opphav == GjoeremaalOpphav.Generert) { <span class="internvern">@(g.ManueltEndret ? "Generert · manuelt endret, vernet ved synk" : "Generert fra gjøremålsregel")</span> }@if (!string.IsNullOrWhiteSpace(g.Notat)) { <div class="oppgavenotat">@g.Notat</div> }</td>
                <td data-label="Tidspunkt">@g.Tidsangivelse</td><td data-label="Ansvarlige">@AnsvarligTekst(g)</td>
                <td data-label="Handlinger"><div class="internhandlinger"><a href="@($"/internkalender/gjoeremaal/{g.Id}")" aria-label="@($"Rediger {g.Tittel}")">Rediger</a><button class="knapp-lenke" aria-label="@($"Slett {g.Tittel}")" disabled="@_arbeider" @onclick="() => VelgSlett(g)">Slett</button></div></td>
            </tr>
        }
        </tbody></table>
    }
    <h2>Ferdig (@_ferdige.Count)</h2>
    @if (_ferdige.Count == 0) { <p class="melding">Ingen fullførte gjøremål ennå.</p> }
    else
    {
        <table class="tabell"><thead><tr><th scope="col">Gjøremål</th><th scope="col">Tidspunkt</th><th scope="col">Ansvarlige</th><th scope="col">Fullført av og når</th><th scope="col">Handlinger</th></tr></thead><tbody>
        @foreach (var g in _ferdige)
        {
            <tr class="ferdig" @key="g.Id"><td data-label="Gjøremål"><strong class="oppgavetittel">@g.Tittel</strong>@if (!string.IsNullOrWhiteSpace(g.Notat)) { <div class="oppgavenotat">@g.Notat</div> }</td><td data-label="Tidspunkt">@g.Tidsangivelse</td><td data-label="Ansvarlige">@AnsvarligTekst(g)</td><td data-label="Fullført av og når">@g.FullfoertAvNavn<br />@Internformat.Tid(g.FullfoertTid)</td><td data-label="Handlinger"><button class="knapp-lenke" aria-label="@($"Gjenåpne {g.Tittel}")" disabled="@_arbeider" @onclick="() => Gjenaapne(g)">Åpne igjen</button></td></tr>
        }
        </tbody></table>
    }
}
</InternkalenderOmraade>
<InternBekreftelse Aapen="@(_fullfoer is not null || _slett is not null)" Valg="@_valg" Tittel="@(_slett is not null ? "Slett gjøremål" : "Fullfør annens gjøremål")" Tekst="@Dialogtekst" Bekrefttekst="@(_slett is not null ? "Ja, slett" : "Ja, meld fullført")" Arbeider="@_arbeider" Feil="@_feil" Bekreft="Bekreft" Avbryt="Avbryt" />

@code {
    [Parameter] public Guid Id { get; set; }
    private Guid? _ruteId;
    private RundeDto? _runde;
    private List<GjoeremaalDto> _aktive = [], _ferdige = [];
    private IReadOnlyList<AnsvarligDto> _ansvarlige = [];
    private bool _lastet, _arbeider;
    private string _hurtigTittel = "", _filterBrukerId = "";
    private string? _megId, _feil, _lastfeil, _melding;
    private GjoeremaalDto? _fullfoer, _slett;
    private int _valg;
    private string Dialogtekst => _slett is { } s ? $"Slette gjøremålet «{s.Tittel}»? Dette kan ikke angres." : $"Du er ikke ansvarlig for «{_fullfoer?.Tittel}». Melde den som fullført likevel?";
    protected override async Task OnParametersSetAsync()
    {
        if (_ruteId == Id) return;
        _ruteId = Id; _runde = null; _hurtigTittel = ""; _filterBrukerId = ""; _melding = Retur.Hent($"/internkalender/runde/{Id}"); _feil = null; _fullfoer = null; _slett = null;
        await Last();
    }
    private async Task Last()
    {
        var id = Id; var filter = _filterBrukerId; var visning = ++Visning; _lastet = false; _lastfeil = null;
        try
        {
            var bruger = await Brukerkilde.HentAsync(Levetid.Token);
            var ansvarlige = await Kalender.HentMuligeAnsvarligeAsync(Levetid.Token);
            var runde = await Kalender.HentRundeAsync(id, Levetid.Token);
            var alle = runde is null ? [] : await Kalender.HentGjoeremaalAsync(id, string.IsNullOrEmpty(filter) ? null : filter, Levetid.Token);
            if (!ErGjeldende(visning)) return;
            _megId = bruger.Id; _ansvarlige = ansvarlige; _runde = runde;
            _aktive = alle.Where(g => g.Status == GjoeremaalStatus.Aktiv).ToList(); _ferdige = alle.Where(g => g.Status == GjoeremaalStatus.Fullfoert).ToList();
        }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _lastfeil = Feiltekst(e, "Kunne ikke laste runden. Prøv igjen."); }
        finally { if (ErGjeldende(visning)) _lastet = true; }
    }
    private async Task Hurtiglegg()
    {
        if (_arbeider || !_lastet || _runde is null || string.IsNullOrWhiteSpace(_hurtigTittel)) return;
        var tittel = _hurtigTittel; var id = _runde.Id;
        await Utfoer(() => Kommando.HurtiglaggAsync(id, tittel, Levetid.Token), $"Gjøremålet «{tittel.Trim()}» er lagt til.", () => _hurtigTittel = "");
    }
    private static string AnsvarligTekst(GjoeremaalDto g) => g.Ansvarlige.Count == 0 ? "Ingen ansvarlige" : string.Join(", ", g.Ansvarlige.Select(a => a.Navn + (a.BrukerId is null ? " (fritekst)" : "")));
    private async Task StartFullfoer(GjoeremaalDto g)
    {
        if (_arbeider) return;
        if (_megId is not null && g.Ansvarlige.Any(a => a.BrukerId == _megId)) await Fullfoer(g);
        else { _fullfoer = g; _valg++; _feil = null; }
    }
    private void VelgSlett(GjoeremaalDto g) { if (_arbeider) return; _slett = g; _valg++; _feil = null; }
    private void Avbryt() { if (_arbeider) return; _fullfoer = null; _slett = null; _feil = null; }
    private async Task Bekreft()
    {
        if (_arbeider) return;
        if (_fullfoer is { } f) await Fullfoer(f);
        else if (_slett is { } s) await Utfoer(() => Kommando.SlettGjoeremaalAsync(s.Id, Levetid.Token), $"Gjøremålet «{s.Tittel}» er slettet.");
    }
    private Task Fullfoer(GjoeremaalDto g) => Utfoer(() => Kommando.FullfoerAsync(g.Id, Levetid.Token), $"Gjøremålet «{g.Tittel}» er fullført.");
    private Task Gjenaapne(GjoeremaalDto g) => Utfoer(() => Kommando.GjenaapneAsync(g.Id, Levetid.Token), $"Gjøremålet «{g.Tittel}» er åpnet igjen.");
    private async Task Utfoer(Func<Task> handling, string melding, Action? etterLagring = null)
    {
        if (_arbeider) return; _arbeider = true; _feil = null; var visning = Visning;
        try { await handling(); if (!ErGjeldende(visning)) return; etterLagring?.Invoke(); _fullfoer = null; _slett = null; _melding = melding; await Last(); }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _feil = Feiltekst(e, "Kunne ikke lagre endringen. Verdiene er beholdt. Prøv igjen."); }
        finally { _arbeider = false; }
    }
    private void FoerNavigasjon(LocationChangingContext context) { if (_arbeider) context.PreventNavigation(); }
}
