@page "/internkalender/gjoeremaal/ny/{RundeId:guid}"
@page "/internkalender/gjoeremaal/{Id:guid}"
@using Aarshjul.Application.Internkalender
@using System.Text.Json
@inherits Internside
@attribute [Authorize(Policy = Autorisasjon.ErSbr)]
@inject IInternkalender Kalender
@inject InternkalenderKommando Kommando
@inject NavigationManager Nav
@inject InternkalenderRetur Retur

<PageTitle>@Tittel</PageTitle>
<NavigationLock ConfirmExternalNavigation="@ErEndret" OnBeforeInternalNavigation="FoerNavigasjon" />
<InternkalenderOmraade>
    <h1>@Tittel</h1>
    @if (!_lastet) { <p class="melding" role="status">Laster gjøremål …</p> }
    else if (_lastfeil is not null) { <div class="feil" role="alert"><p>@_lastfeil</p><button class="knapp" @onclick="Last">Prøv igjen</button></div> }
    else if (_inndata is null) { <p class="melding">Gjøremålet eller runden finnes ikke.</p><a href="/internkalender">Til oversikten</a> }
    else
    {
        <p class="ingress">@_rundeEtikett · Tittel er nok. Du kan legge til tidspunkt og flere ansvarlige nå eller senere.</p>
        <form class="skjema" aria-label="@Tittel" @onsubmit="Lagre" @onsubmit:preventDefault="true" novalidate>
            @if (_feil is not null) { <div class="feil" role="alert" tabindex="-1" @ref="_feilfelt">@_feil</div> }
            <fieldset class="internskjemafelter" disabled="@_arbeider">
                <label>Tittel<input @bind="_inndata.Tittel" @bind:event="oninput" /></label>
                <label>Notat<textarea @bind="_inndata.Notat" @bind:event="oninput" rows="3"></textarea></label>
                <label>Tidfesting<select @bind="_inndata.Tidfestingstype"><option value="@Tidfestingstype.Ingen">Uten dato</option><option value="@Tidfestingstype.KonkretDato">Konkret dato</option><option value="@Tidfestingstype.TentativMaaned">Tentativ måned</option><option value="@Tidfestingstype.AnkerRelativ">Relativt til en milepæl (anker-løp)</option><option value="@Tidfestingstype.Rundeposisjon">Posisjon i runden</option></select></label>
                @switch (_inndata.Tidfestingstype)
                {
                    case Tidfestingstype.KonkretDato:
                        <label>Dato<input type="date" @bind="_inndata.Dato" /></label>
                        break;
                    case Tidfestingstype.TentativMaaned:
                        <div class="skjemarad"><label>Måned (velg en dato i måneden)<input type="date" @bind="_inndata.Dato" /></label><label>Kvalifikator<select @bind="_kvalifikatorValg"><option value="">(ingen)</option><option value="Primo">Primo</option><option value="Medio">Medio</option><option value="Ultimo">Ultimo</option></select></label></div>
                        <p class="hint">Bare måned og år brukes ved visning. Dagen du velger, er ikke en fastsatt dagsfrist.</p>
                        break;
                    case Tidfestingstype.AnkerRelativ:
                        <div class="skjemarad"><label>Anker-løp (publisert frist)<input @bind="_inndata.AnkerLoep" list="intern-ankerloep" placeholder="f.eks. rammefordeling" /></label><label>Dager forskyvning (negativ = før, positiv = etter)<input type="number" @bind="_inndata.AnkerOffsetDager" /></label></div>
                        <datalist id="intern-ankerloep"><option value="marskonferanse" /><option value="rammefordeling" /><option value="fremleggelse" /><option value="gulbok" /><option value="rnb" /><option value="nysaldering" /><option value="statsregnskap" /></datalist>
                        <p class="hint">Ankeret er en godkjent frist med samme løp og rundeår. Mangler ankeret, vises «Venter på ankerdato». Et tentativt anker gir ingen sikker dagsdato. Nye ankerdatoer endrer ikke lagrede gjøremål ved vanlig lesing.</p>
                        break;
                    case Tidfestingstype.Rundeposisjon:
                        <label>Posisjon<select @bind="_inndata.Rundeposisjon"><option value="">– velg –</option><option value="@Domain.Rundeposisjon.Start">Start av runden</option><option value="@Domain.Rundeposisjon.Tidlig">Tidlig i runden</option><option value="@Domain.Rundeposisjon.Midt">Midt i runden</option><option value="@Domain.Rundeposisjon.Sent">Sent i runden</option><option value="@Domain.Rundeposisjon.Slutt">Slutten av runden</option></select></label>
                        <p class="hint">Posisjonen viser et sted i rundens arbeidsspenn. Øvrig har ikke et slikt spenn.</p>
                        break;
                }
                <InternAnsvarlige @key="_lastenoekkel" Ansvarlige="_inndata.Ansvarlige" Mulige="_muligeAnsvarlige" Endret="StateHasChanged" />
                <div class="internhandlinger"><button type="submit" class="knapp knapp-primær">@(_arbeider ? "Lagrer …" : "Lagre")</button><button type="button" class="knapp" @onclick="Avbryt">Avbryt</button></div>
            </fieldset>
        </form>
    }
</InternkalenderOmraade>
<InternBekreftelse Aapen="@(_ventendeUri is not null)" Valg="@_valg" Tittel="Ulagrede endringer" Tekst="Du har et gjøremål som ikke er lagret. Fortsett å redigere for å beholde feltene, eller forkast endringene og gå videre." Avbryttekst="Fortsett å redigere" Bekrefttekst="Forkast endringene" Avbryt="Fortsett" Bekreft="Forkast" />

@code {
    [Parameter] public Guid? RundeId { get; set; }
    [Parameter] public Guid? Id { get; set; }
    private GjoeremaalInndata? _inndata;
    private IReadOnlyList<AnsvarligDto> _muligeAnsvarlige = [];
    private Guid? _lagretId;
    private Guid _rundeForRetur;
    private string _rundeEtikett = "", _kvalifikatorValg = "", _opprinnelig = "";
    private string? _feil, _lastfeil, _lastenoekkel, _ventendeUri;
    private bool _lastet, _arbeider, _tillatNavigasjon, _fokuserFeil;
    private int _valg;
    private ElementReference _feilfelt;
    private string Tittel => Id is null ? "Nytt gjøremål" : "Rediger gjøremål";
    private string Bilde() => JsonSerializer.Serialize(new { Data = _inndata, Kvalifikator = _kvalifikatorValg });
    private bool ErEndret => !_tillatNavigasjon && _inndata is not null && Bilde() != _opprinnelig;
    protected override async Task OnParametersSetAsync()
    {
        var noekkel = $"{Id}/{RundeId}";
        if (_lastenoekkel == noekkel) return;
        _lastenoekkel = noekkel; await Last();
    }
    private async Task Last()
    {
        var visning = ++Visning; var id = Id; var rundeId = RundeId;
        _lastet = false; _inndata = null; _lagretId = null; _feil = null; _lastfeil = null; _ventendeUri = null; _tillatNavigasjon = false; _fokuserFeil = false;
        try
        {
            var ansvarlige = await Kalender.HentMuligeAnsvarligeAsync(Levetid.Token);
            var data = id is { } maal ? await Kalender.HentForRedigeringAsync(maal, Levetid.Token) : new GjoeremaalInndata();
            var retur = id is { } g ? await Kalender.HentRundeIdForGjoeremaalAsync(g, Levetid.Token) : rundeId;
            var runde = retur is { } r ? await Kalender.HentRundeAsync(r, Levetid.Token) : null;
            if (!ErGjeldende(visning)) return;
            _muligeAnsvarlige = ansvarlige; _inndata = runde is null ? null : data; _lagretId = id; _rundeForRetur = retur ?? Guid.Empty; _rundeEtikett = runde?.Etikett ?? "";
            _kvalifikatorValg = _inndata?.Datokvalifikator?.ToString() ?? ""; _opprinnelig = Bilde();
        }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _lastfeil = Feiltekst(e, "Kunne ikke laste gjøremålet. Prøv igjen."); }
        finally { if (ErGjeldende(visning)) _lastet = true; }
    }
    private async Task Lagre()
    {
        if (_arbeider || !_lastet || _inndata is not { } data || _rundeForRetur == Guid.Empty) return;
        var id = _lagretId; var rundeId = _rundeForRetur; var visning = Visning;
        var lagring = JsonSerializer.Deserialize<GjoeremaalInndata>(JsonSerializer.Serialize(data))!;
        lagring.Datokvalifikator = lagring.Tidfestingstype == Tidfestingstype.TentativMaaned && Enum.TryParse<Datokvalifikator>(_kvalifikatorValg, out var k) ? k : null;
        _arbeider = true; _feil = null;
        try
        {
            if (id is { } g) await Kommando.OppdaterGjoeremaalAsync(g, lagring, Levetid.Token);
            else await Kommando.OpprettGjoeremaalAsync(rundeId, lagring, Levetid.Token);
            if (!ErGjeldende(visning)) return;
            Retur.Lagre($"/internkalender/runde/{rundeId}", $"Gjøremålet «{lagring.Tittel.Trim()}» er lagret.");
            _tillatNavigasjon = true; _arbeider = false; Nav.NavigateTo($"/internkalender/runde/{rundeId}");
        }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) { _feil = Feiltekst(e, "Kunne ikke lagre gjøremålet. Verdiene er beholdt. Prøv igjen."); _fokuserFeil = true; } }
        finally { _arbeider = false; }
    }
    private void Avbryt() { if (_arbeider) return; _tillatNavigasjon = true; Nav.NavigateTo(_rundeForRetur == Guid.Empty ? "/internkalender" : $"/internkalender/runde/{_rundeForRetur}"); }
    private void FoerNavigasjon(LocationChangingContext context)
    {
        if (_arbeider) { context.PreventNavigation(); return; }
        if (!ErEndret) return;
        context.PreventNavigation(); _ventendeUri = context.TargetLocation; _valg++;
    }
    private void Fortsett() => _ventendeUri = null;
    private void Forkast() { if (_ventendeUri is not { } uri) return; _ventendeUri = null; _tillatNavigasjon = true; Nav.NavigateTo(uri); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (_fokuserFeil && !Avsluttet) { _fokuserFeil = false; await _feilfelt.FocusAsync(); } }
}
