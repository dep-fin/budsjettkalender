@page "/internkalender"
@using Aarshjul.Application.Internkalender
@inherits Internside
@attribute [Authorize(Policy = Autorisasjon.ErSbr)]
@inject IInternkalender Kalender
@inject InternkalenderKommando Kommando
@inject NavigationManager Nav
@inject TimeProvider Klokke

<PageTitle>Internkalender (SBR)</PageTitle>
<NavigationLock OnBeforeInternalNavigation="FoerNavigasjon" />
<InternkalenderOmraade>
    <div class="admintopp">
        <div><h1>Internkalender for SBR</h1><p class="ingress">Runder og gjøremål for det interne arbeidet. Oppgavene er atskilt fra publiserte frister.</p></div>
        <button class="knapp" disabled="@_arbeider" @onclick="AapneOvrig">Åpne «Øvrig»</button>
    </div>
    @if (_melding is not null) { <p class="internstatus" role="status">@_melding</p> }
    @if (_feil is not null && _slett is null) { <p class="feil" role="alert">@_feil</p> }
    <section class="internkort" aria-labelledby="ny-internrunde">
        <h2 id="ny-internrunde">Ny runde</h2>
        <form @onsubmit="OpprettRunde" @onsubmit:preventDefault="true" novalidate>
            <fieldset class="internskjemafelter" disabled="@(_arbeider || !_lastet)">
                <div class="skjemarad">
                    <label>Rundetype<select @bind="_nyType">@foreach (var t in Runder.Genererbare) { <option value="@t">@Runder.Navn(t)</option> }</select></label>
                    <label>År<input type="number" min="1" max="9999" @bind="_nyAar" /></label>
                    <button type="submit" class="knapp knapp-primær">@(_arbeider ? "Arbeider …" : "Opprett runde")</button>
                </div>
                <label class="filtervalg"><input type="checkbox" @bind="_generer" />Fyll fra generelle regler</label>
            </fieldset>
        </form>
        <p class="hint">Mars- og augustrunden har normalt oppgaver året før rundeåret. Øvrig er én stående runde uten år og regelgenerering.</p>
    </section>
    <h2>Internrunder</h2>
    @if (!_lastet) { <p class="melding" role="status">Laster runder …</p> }
    else if (_lastfeil is not null)
    {
        <div class="feil" role="alert"><p>@_lastfeil</p><button class="knapp" @onclick="Last">Prøv igjen</button></div>
    }
    else if (_runder.Count == 0) { <p class="internkort">Ingen runder opprettet ennå. Opprett en runde eller åpne Øvrig.</p> }
    else
    {
        <table class="tabell">
            <thead><tr><th scope="col">Runde</th><th scope="col">Aktive</th><th scope="col">Ferdige</th><th scope="col">Sist synkronisert</th><th scope="col">Handlinger</th></tr></thead>
            <tbody>@foreach (var r in _runder)
            {
                <tr @key="r.Id">
                    <td data-label="Runde"><a href="@($"/internkalender/runde/{r.Id}")"><strong class="oppgavetittel">@r.Etikett</strong></a></td>
                    <td data-label="Aktive">@r.AntallAktive</td><td data-label="Ferdige">@r.AntallFullfoerte</td>
                    <td data-label="Sist synkronisert">@Internformat.Tid(r.SistSynkronisert)</td>
                    <td data-label="Handlinger"><div class="internhandlinger"><a href="@($"/internkalender/runde/{r.Id}")" aria-label="@($"Åpne {r.Etikett}")">Åpne</a><button class="knapp-lenke" aria-label="@($"Slett {r.Etikett}")" disabled="@_arbeider" @onclick="() => VelgSlett(r)">Slett</button></div></td>
                </tr>
            }</tbody>
        </table>
    }
</InternkalenderOmraade>
<InternBekreftelse Aapen="@(_slett is not null)" Valg="@_valg" Tittel="Slett internrunde" Tekst="@($"Slette runden «{_slett?.Etikett}» med alle gjøremål? Dette kan ikke angres.")" Bekrefttekst="Ja, slett" Arbeider="@_arbeider" Feil="@_feil" Bekreft="BekreftSlett" Avbryt="AvbrytSlett" />

@code {
    private IReadOnlyList<RundeDto> _runder = [];
    private bool _lastet, _arbeider, _generer = true;
    private Rundetype _nyType = Rundetype.Marsrunden;
    private int _nyAar, _valg;
    private string? _feil, _lastfeil, _melding;
    private RundeDto? _slett;
    protected override async Task OnInitializedAsync() { _nyAar = Datohjelp.Idag(Klokke).Year + 1; await Last(); }
    private async Task Last()
    {
        var visning = ++Visning; _lastet = false; _lastfeil = null;
        try { var data = await Kalender.HentRunderAsync(Levetid.Token); if (ErGjeldende(visning)) _runder = data; }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _lastfeil = Feiltekst(e, "Kunne ikke laste rundene. Prøv igjen."); }
        finally { if (ErGjeldende(visning)) _lastet = true; }
    }
    private async Task OpprettRunde()
    {
        if (_arbeider || !_lastet) return;
        _arbeider = true; _feil = null; var visning = Visning;
        try { var id = await Kommando.OpprettRundeAsync(_nyType, _nyAar, _generer, Levetid.Token); if (ErGjeldende(visning)) { _arbeider = false; Nav.NavigateTo($"/internkalender/runde/{id}"); } }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _feil = Feiltekst(e, "Kunne ikke opprette runden. Valgene er beholdt. Prøv igjen."); }
        finally { _arbeider = false; }
    }
    private async Task AapneOvrig()
    {
        if (_arbeider) return; _arbeider = true; _feil = null; var visning = Visning;
        try { var id = await Kommando.AapneOvrigAsync(Levetid.Token); if (ErGjeldende(visning)) { _arbeider = false; Nav.NavigateTo($"/internkalender/runde/{id}"); } }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _feil = Feiltekst(e, "Kunne ikke åpne Øvrig. Prøv igjen."); }
        finally { _arbeider = false; }
    }
    private void VelgSlett(RundeDto r) { if (_arbeider) return; _slett = r; _valg++; _feil = null; }
    private void AvbrytSlett() { if (!_arbeider) { _slett = null; _feil = null; } }
    private async Task BekreftSlett()
    {
        if (_arbeider || _slett is not { } r) return;
        _arbeider = true; _feil = null; var visning = Visning;
        try { await Kommando.SlettRundeAsync(r.Id, Levetid.Token); if (!ErGjeldende(visning)) return; _slett = null; _melding = $"Runden «{r.Etikett}» er slettet."; await Last(); }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _feil = Feiltekst(e, "Kunne ikke slette runden. Prøv igjen."); }
        finally { _arbeider = false; }
    }
    private void FoerNavigasjon(LocationChangingContext context) { if (_arbeider) context.PreventNavigation(); }
}
