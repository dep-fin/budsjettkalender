@using Aarshjul.Application.Internkalender

<fieldset class="synlighet">
    <legend>@Overskrift</legend>
    @if (Ansvarlige.Count == 0) { <p class="melding">Ingen ansvarlige valgt.</p> }
    else
    {
        <ul class="ansvarligliste">@foreach (var a in Ansvarlige)
        {
            <li><span>@a.Navn @(a.BrukerId is null ? "(fritekst)" : "")</span><button type="button" class="knapp-lenke" aria-label="@($"Fjern {a.Navn}")" @onclick="() => Fjern(a)">Fjern</button></li>
        }</ul>
    }
    <div class="skjemarad">
        <label>@Listeetikett<select @bind="_valgtBrukerId"><option value="">– velg –</option>@foreach (var p in Mulige.Where(p => Ansvarlige.All(a => a.BrukerId != p.BrukerId))) { <option value="@p.BrukerId">@p.Navn</option> }</select></label>
        <button type="button" class="knapp" disabled="@string.IsNullOrEmpty(_valgtBrukerId)" @onclick="LeggTilBruker">Legg til ansvarlig</button>
    </div>
    @if (Mulige.Count == 0) { <p class="hint">Ingen brukere er tilgjengelige i listen. Du kan fortsatt legge til et navn.</p> }
    <div class="skjemarad"><label>@Fritekstetikett<input @bind="_fritekstNavn" @bind:event="oninput" placeholder="Navn" /></label><button type="button" class="knapp" disabled="@string.IsNullOrWhiteSpace(_fritekstNavn)" @onclick="LeggTilNavn">Legg til navn</button></div>
    <p class="hint">Flere brukere og fritekstnavn kan være ansvarlige samtidig. Fritekstnavn gir ikke treff i Mine gjøremål.</p>
</fieldset>
@code {
    [Parameter, EditorRequired] public List<AnsvarligDto> Ansvarlige { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<AnsvarligDto> Mulige { get; set; } = [];
    [Parameter] public EventCallback Endret { get; set; }
    [Parameter] public string Overskrift { get; set; } = "Ansvarlige";
    [Parameter] public string Listeetikett { get; set; } = "Legg til fra listen";
    [Parameter] public string Fritekstetikett { get; set; } = "Legg til som fritekst";
    private string _valgtBrukerId = "", _fritekstNavn = "";
    private async Task LeggTilBruker()
    {
        var p = Mulige.FirstOrDefault(a => a.BrukerId == _valgtBrukerId);
        _valgtBrukerId = "";
        if (p is null || Ansvarlige.Any(a => a.BrukerId == p.BrukerId)) return;
        Ansvarlige.Add(p);
        await Endret.InvokeAsync();
    }
    private async Task LeggTilNavn()
    {
        if (string.IsNullOrWhiteSpace(_fritekstNavn)) return;
        Ansvarlige.Add(new(null, _fritekstNavn.Trim())); _fritekstNavn = "";
        await Endret.InvokeAsync();
    }
    private async Task Fjern(AnsvarligDto ansvarlig)
    {
        if (Ansvarlige.Remove(ansvarlig)) await Endret.InvokeAsync();
    }
}
