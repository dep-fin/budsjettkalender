@page "/internkalender/regler/ny"
@page "/internkalender/regler/{Id:guid}"
@using Aarshjul.Application.Internkalender
@using System.Text.Json
@inherits Internside
@attribute [Authorize(Policy = Autorisasjon.ErSbr)]
@inject IGjoeremaalRegler Regler
@inject IInternkalender Kalender
@inject NavigationManager Nav
@inject InternkalenderKommando Kommando
@inject InternkalenderRetur Retur

<PageTitle>@Tittel</PageTitle>

<NavigationLock ConfirmExternalNavigation="@ErEndret" OnBeforeInternalNavigation="FoerNavigasjon" /><InternkalenderOmraade><h1>@Tittel</h1><p class="ingress">En gjøremålsregel fyller nye internrunder og gir forslag ved synkronisering. Lagrede regelendringer endrer ikke eksisterende gjøremål direkte.</p>

@if (!_lastet)
{
    <p class="melding" role="status">Laster gjøremålsregel …</p>
}
else if (_lastfeil is not null) { <div class="feil" role="alert"><p>@_lastfeil</p><button class="knapp" @onclick="Last">Prøv igjen</button></div> } else if (_inndata is null)
{
    <p class="melding">Regelen finnes ikke.</p>
    <a href="/internkalender/regler">Til gjøremålsreglene</a>
}
else
{
    @if (_feil is not null)
    {
        <div class="feil" role="alert" tabindex="-1" @ref="_feilfelt">@_feil</div>
    }

    <form class="skjema" aria-label="@Tittel" @onsubmit="Lagre" @onsubmit:preventDefault="true" novalidate><fieldset class="internskjemafelter" disabled="@_arbeider">
        <label>Tittel
            <input @bind="_inndata.Tittel" @bind:event="oninput" />
        </label>

        <label>Notat
            <textarea @bind="_inndata.Notat" @bind:event="oninput" rows="3"></textarea>
        </label>

        <fieldset class="synlighet">
            <legend>Gjelder rundetyper (huk av én eller flere)</legend>
            <label class="filtervalg">
                <input type="checkbox" @bind:get="AlleValgt" @bind:set="VekslAlle" /> Hver runde (alle)
            </label>
            @foreach (var t in Runder.Genererbare)
            {
                <label class="filtervalg">
                    <input type="checkbox"
                           @bind:get="_inndata.Rundetyper.Contains(t)"
                           @bind:set="på => VekslType(t, på)" />
                    @Runder.Navn(t)
                </label>
            }
        </fieldset>

        <label>Tidfesting
            <select @bind="_inndata.Tidfestingstype">
                <option value="@Tidfestingstype.Ingen">Uten dato</option>
                <option value="@Tidfestingstype.KonkretDato">Fast dag i måned</option>
                <option value="@Tidfestingstype.TentativMaaned">Tentativ måned</option>
                <option value="@Tidfestingstype.AnkerRelativ">Relativt til en milepæl (anker-løp)</option>
                <option value="@Tidfestingstype.Rundeposisjon">Posisjon i runden</option>
            </select>
        </label>

        @switch (_inndata.Tidfestingstype)
        {
            case Tidfestingstype.KonkretDato:
                <div class="skjemarad">
                    <label>Måned (1–12)<input type="number" @bind="_inndata.Maaned" style="width:6rem" /></label>
                    <label>Dag (1–31)<input type="number" @bind="_inndata.Dag" style="width:6rem" /></label>
                    <label>Årsjustering<input type="number" @bind="_inndata.AarforskyvningJustering" style="width:6rem" /></label>
                </div>
                <p class="melding">Kalenderår = rundeår + rundens standardforskyvning + årsjustering. Bruk årsjustering unntaksvis (f.eks. regnskapsoppgave som lander året etter).</p>
                break;

            case Tidfestingstype.TentativMaaned:
                <div class="skjemarad">
                    <label>Måned (1–12)<input type="number" @bind="_inndata.Maaned" style="width:6rem" /></label>
                    <label>Kvalifikator
                        <select @bind="_kvalifikatorValg">
                            <option value="">(ingen)</option>
                            <option value="Primo">Primo</option>
                            <option value="Medio">Medio</option>
                            <option value="Ultimo">Ultimo</option>
                        </select>
                    </label>
                    <label>Årsjustering<input type="number" @bind="_inndata.AarforskyvningJustering" style="width:6rem" /></label>
                </div>
                break;

            case Tidfestingstype.AnkerRelativ:
                <div class="skjemarad">
                    <label>Anker-løp (publisert frist)
                        <input @bind="_inndata.AnkerLoep" list="loepliste" placeholder="f.eks. rammefordeling" />
                        <datalist id="loepliste">
                            <option value="marskonferanse" /><option value="rammefordeling" /><option value="fremleggelse" />
                            <option value="gulbok" /><option value="rnb" /><option value="nysaldering" /><option value="statsregnskap" />
                        </datalist>
                    </label>
                    <label>Dager forskyvning<input type="number" @bind="_inndata.AnkerOffsetDager" style="width:8rem" /></label>
                </div>
                <p class="hint">Bruk negative dager før ankeret, 0 samme dag og positive dager etter. Ankeret må være en godkjent frist med samme løp og rundeår. Mangler ankeret, vises «Venter på ankerdato». Et tentativt anker gir ingen sikker dagsdato.</p>
                break;

            case Tidfestingstype.Rundeposisjon:
                <label>Posisjon
                    <select @bind="_inndata.Rundeposisjon"><option value="">– velg –</option>
                        <option value="@Domain.Rundeposisjon.Start">Start av runden</option>
                        <option value="@Domain.Rundeposisjon.Tidlig">Tidlig i runden</option>
                        <option value="@Domain.Rundeposisjon.Midt">Midt i runden</option>
                        <option value="@Domain.Rundeposisjon.Sent">Sent i runden</option>
                        <option value="@Domain.Rundeposisjon.Slutt">Slutten av runden</option>
                    </select>
                </label>
                break;
        }

        <InternAnsvarlige @key="_lastenoekkel" Ansvarlige="_inndata.Ansvarlige" Mulige="_muligeAnsvarlige" Endret="StateHasChanged" Overskrift="Standard ansvarlige (kopieres til hvert generert gjøremål)" Listeetikett="Fra listen" Fritekstetikett="Fritekst" />

        <div class="skjemarad">
            <button type="submit" class="knapp knapp-primær">@(_arbeider ? "Lagrer …" : "Lagre")</button>
            <button type="button" class="knapp" @onclick="Avbryt">Avbryt</button>
        </div>
    </fieldset></form>
}

</InternkalenderOmraade>
<InternBekreftelse Aapen="@(_ventendeUri is not null)" Valg="@_valg" Tittel="Ulagrede endringer" Tekst="Du har en gjøremålsregel som ikke er lagret. Fortsett å redigere for å beholde feltene, eller forkast endringene og gå videre." Avbryttekst="Fortsett å redigere" Bekrefttekst="Forkast endringene" Avbryt="Fortsett" Bekreft="Forkast" />
@code {
    [Parameter] public Guid? Id { get; set; }
    private RegelInndata? _inndata;
    private IReadOnlyList<AnsvarligDto> _muligeAnsvarlige = [];
    private Guid? _lagretId;
    private string _kvalifikatorValg = "", _opprinnelig = "";
    private string? _feil, _lastfeil, _lastenoekkel, _ventendeUri;
    private bool _lastet, _arbeider, _tillatNavigasjon, _fokuserFeil;
    private int _valg;
    private ElementReference _feilfelt;
    private string Tittel => Id is null ? "Ny regel" : "Rediger regel";
    private bool AlleValgt => _inndata is not null && Runder.Genererbare.All(t => _inndata.Rundetyper.Contains(t));
    private string Bilde() => JsonSerializer.Serialize(new { Data = _inndata, Kvalifikator = _kvalifikatorValg });
    private bool ErEndret => !_tillatNavigasjon && _inndata is not null && Bilde() != _opprinnelig;
    protected override async Task OnParametersSetAsync()
    {
        var noekkel = Id?.ToString() ?? "ny";
        if (_lastenoekkel == noekkel) return;
        _lastenoekkel = noekkel; await Last();
    }
    private async Task Last()
    {
        var visning = ++Visning; var id = Id;
        _lastet = false; _inndata = null; _lagretId = null; _feil = null; _lastfeil = null; _ventendeUri = null; _tillatNavigasjon = false; _fokuserFeil = false;
        try
        {
            var ansvarlige = await Kalender.HentMuligeAnsvarligeAsync(Levetid.Token);
            var data = id is { } maal ? await Regler.HentForRedigeringAsync(maal, Levetid.Token) : new RegelInndata();
            if (!ErGjeldende(visning)) return;
            _muligeAnsvarlige = ansvarlige; _inndata = data; _lagretId = id;
            _kvalifikatorValg = data?.Datokvalifikator?.ToString() ?? ""; _opprinnelig = Bilde();
        }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) _lastfeil = Feiltekst(e, "Kunne ikke laste gjøremålsregelen. Prøv igjen."); }
        finally { if (ErGjeldende(visning)) _lastet = true; }
    }
    private void VekslAlle(bool paa)
    {
        if (_arbeider || _inndata is null) return;
        _inndata.Rundetyper.Clear(); if (paa) _inndata.Rundetyper.AddRange(Runder.Genererbare);
    }
    private void VekslType(Rundetype type, bool paa)
    {
        if (_arbeider || _inndata is null) return;
        if (paa && !_inndata.Rundetyper.Contains(type)) _inndata.Rundetyper.Add(type);
        else if (!paa) _inndata.Rundetyper.Remove(type);
    }
    private async Task Lagre()
    {
        if (_arbeider || !_lastet || _inndata is not { } data) return;
        var id = _lagretId; var visning = Visning;
        var lagring = JsonSerializer.Deserialize<RegelInndata>(JsonSerializer.Serialize(data))!;
        lagring.Datokvalifikator = lagring.Tidfestingstype == Tidfestingstype.TentativMaaned && Enum.TryParse<Datokvalifikator>(_kvalifikatorValg, out var k) ? k : null;
        _arbeider = true; _feil = null;
        try
        {
            if (id is { } r) await Kommando.OppdaterRegelAsync(r, lagring, Levetid.Token);
            else await Kommando.OpprettRegelAsync(lagring, Levetid.Token);
            if (!ErGjeldende(visning)) return;
            Retur.Lagre("/internkalender/regler", $"Regelen «{lagring.Tittel.Trim()}» er lagret. Eksisterende gjøremål er beholdt.");
            _tillatNavigasjon = true; _arbeider = false; Nav.NavigateTo("/internkalender/regler");
        }
        catch (OperationCanceledException) when (Levetid.IsCancellationRequested) { }
        catch (Exception e) { if (ErGjeldende(visning)) { _feil = Feiltekst(e, "Kunne ikke lagre gjøremålsregelen. Verdiene er beholdt. Prøv igjen."); _fokuserFeil = true; } }
        finally { _arbeider = false; }
    }
    private void Avbryt() { if (_arbeider) return; _tillatNavigasjon = true; Nav.NavigateTo("/internkalender/regler"); }
    private void FoerNavigasjon(LocationChangingContext context)
    {
        if (_arbeider) { context.PreventNavigation(); return; }
        if (!ErEndret) return;
        context.PreventNavigation(); _ventendeUri = context.TargetLocation; _valg++;
    }
    private void Fortsett() => _ventendeUri = null;
    private void Forkast() { if (_ventendeUri is not { } uri) return; _ventendeUri = null; _tillatNavigasjon = true; Nav.NavigateTo(uri); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (_fokuserFeil && !Avsluttet) { _fokuserFeil = false; await _feilfelt.FocusAsync(); } }
}
